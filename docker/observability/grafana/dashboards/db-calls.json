      "id": 1,
      "targets": [
        {
          "expr": "sum by (service_name, db_system, db_operation) (rate(traces_spanmetrics_calls_total{db_system!=\"\"}[5m]))",
          "legendFormat": "{{service_name}} {{db_system}} {{db_operation}}",
          "refId": "A"
        },
        {
          "expr": "sum by (operation) (rate(integration_console_active_record_queries_total[5m]))",
          "legendFormat": "rails active_record {{operation}}",
          "refId": "B"
        },
        {
          "expr": "sum by (operation) (rate(oracle_worker_oracle_calls_total[5m]))",
          "legendFormat": "oracle-worker {{operation}}",
          "refId": "C"
        }
      ],
      "title": "DB Call Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
