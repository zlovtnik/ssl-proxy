FROM rust:1.95.0-slim-bookworm AS builder
WORKDIR /build
COPY docker/local/mac-egress-bridge.rs .
RUN rustc --edition=2021 -D warnings -C opt-level=2 mac-egress-bridge.rs -o mac-egress-bridge

FROM debian:bookworm-slim
COPY --from=builder /build/mac-egress-bridge /usr/local/bin/mac-egress-bridge
# The generated token is owner-only in the shared local secrets volume.
USER root
ENTRYPOINT ["/usr/local/bin/mac-egress-bridge"]
