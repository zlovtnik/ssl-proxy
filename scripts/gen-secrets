#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
ROTATOR_DIR="$ROOT_DIR/apps/wg-key-rotator"

args=("$@")

if [ "${#args[@]}" -eq 0 ]; then
    args=(generate)
elif [ "${args[0]}" = "--dry-run" ] || [ "${args[0]}" = "--force" ]; then
    args=(generate "$@")
fi

case "${args[0]}" in
    generate|check|repair|env) ;;
    *)
        cat >&2 <<'USAGE'
Usage:
  scripts/gen-secrets [--force] [--dry-run]
  scripts/gen-secrets generate [--force] [--dry-run]
  scripts/gen-secrets check
  scripts/gen-secrets repair
  scripts/gen-secrets env
USAGE
        exit 64
        ;;
esac

cd "$ROTATOR_DIR"
export ROTATOR_REPO_ROOT="${ROTATOR_REPO_ROOT:-$ROOT_DIR}"

exec elixir \
    -r lib/wg_key_rotator/error.ex \
    -r lib/wg_key_rotator/atomic_file.ex \
    -r lib/wg_key_rotator/command.ex \
    -r lib/wg_key_rotator/config.ex \
    -r lib/wg_key_rotator/keygen.ex \
    -r lib/wg_key_rotator/peer_config.ex \
    -r lib/wg_key_rotator/message.ex \
    -r lib/wg_key_rotator/json.ex \
    -r lib/wg_key_rotator/health.ex \
    -r lib/wg_key_rotator/deploy.ex \
    -r lib/wg_key_rotator/waha_client.ex \
    -r lib/wg_key_rotator/rotation.ex \
    -r lib/wg_key_rotator/secrets.ex \
    -r lib/wg_key_rotator.ex \
    -r lib/wg_key_rotator/cli.ex \
    -e 'WgKeyRotator.CLI.main(["secrets" | System.argv()])' -- "${args[@]}"
