apiVersion: v1
data:
  dynamic.yaml: |
    http:
      routers:
        keycloak:
          rule: "Host(`identity.prod.ssl-proxy.internal`) && (PathPrefix(`/realms`) || PathPrefix(`/resources`))"
          entryPoints: [websecure]
          priority: 30
          service: keycloak
          tls:
            store:
              name: default
        backend:
          rule: "Host(`identity.prod.ssl-proxy.internal`) && PathPrefix(`/api`)"
          entryPoints: [websecure]
          priority: 20
          service: backend
          tls:
            store:
              name: default
        ui:
          rule: "Host(`identity.prod.ssl-proxy.internal`) && PathPrefix(`/`)"
          entryPoints: [websecure]
          priority: 10
          service: ui
          tls:
            store:
              name: default
      services:
        backend:
          loadBalancer:
            servers:
              - url: "http://ssl-proxy-schema-migrator-backend:8080"
        keycloak:
          loadBalancer:
            servers:
              - url: "http://ssl-proxy-schema-migrator-keycloak:8080"
        ui:
          loadBalancer:
            servers:
              - url: "http://ssl-proxy-schema-migrator-ui:80"
    tls:
      stores:
        default:
          defaultCertificate:
            certFile: /etc/tls-cert/tls.crt
            keyFile: /etc/tls-cert/tls.key
