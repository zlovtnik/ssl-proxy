{
  "name": "product-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "review": "node scripts/review.mjs",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs README.md AGENTS.md",
    "format:check": "prettier --check src scripts tests docs *.json *.ts *.mjs README.md AGENTS.md",
    "test": "playwright test",
    "test:all-browsers": "PLAYWRIGHT_ALL_BROWSERS=1 playwright test"
  },
  "dependencies": {
    "@astrojs/solid-js": "7.0.2",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@lucide/astro": "1.52.0",
    "astro": "7.3.5",
    "lucide-solid": "1.52.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.11.3",
    "@cloudflare/workers-types": "5.20261010.1",
    "@playwright/test": "1.63.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3"
  }
}
