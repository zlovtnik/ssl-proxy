---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
// Preloaded so the first paint already uses the intended faces; a late swap
// reflows the hero and header on a cold cache.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/site.css';
import { contact } from '../data/products';
import PrivacyConsent from '../components/PrivacyConsent.astro';
import { ArrowUpRight, Menu } from '@lucide/astro';
interface Props {
  title: string;
  description: string;
  product?: string;
  structuredData?: Record<string, unknown>;
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
}
const {
  title,
  description,
  product,
  structuredData,
  breadcrumbs = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const publicBuild =
  canonical.hostname !== 'localhost' && canonical.hostname !== '127.0.0.1';
const candidateMeasurementId =
  import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
const analyticsMeasurementId =
  import.meta.env.PROD &&
  ['rclabs.uk', 'www.rclabs.uk'].includes(canonical.hostname) &&
  candidateMeasurementId &&
  /^G-[A-Z0-9]{5,}$/.test(candidateMeasurementId)
    ? candidateMeasurementId
    : '';
const navigation = [
  ['/products/', 'Products'],
  ['/guides/', 'Guides'],
  ['/#approach', 'How they work'],
  ['/#faq', 'FAQ'],
];
const breadcrumbData =
  breadcrumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.path, Astro.site).href,
        })),
      }
    : undefined;
---

<!doctype html>
<html
  lang="en"
  data-theme="dark"
  data-ga4-id={analyticsMeasurementId || undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | RCLabs</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090909" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={monoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {(!publicBuild || noindex) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RCLabs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL('/social-preview.png', Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="RCLabs: wireless evidence, SQL review, and WireGuard VPN / Proxy."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | RCLabs`} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL('/social-preview.png', Astro.site)}
    />
    {structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}
    {breadcrumbData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbData)}
      />
    )}
    <script is:inline>
      try {
        if (sessionStorage.getItem('rclabs-display-persistence') === 'off') {
          throw new Error('Display settings are not being persisted.');
        }
        const preferences = JSON.parse(
          localStorage.getItem('rclabs-reading') || '{}',
        );
        for (const key of ['size', 'width', 'spacing', 'motion']) {
          if (
            [
              'standard',
              'large',
              'extra',
              'narrow',
              'wide',
              'comfortable',
              'reduced',
            ].includes(preferences[key])
          )
            document.documentElement.dataset[key] = preferences[key];
        }
      } catch {
        /* Browser storage is optional. */
      }
    </script>
  </head>
  <body class={product}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-top">
      <header class="site-header shell">
        <a href="/" class="wordmark" aria-label="RCLabs home">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <path
              d="M5 25V7h13l8 9-8 9H5zm7-5h5l4-4-4-4h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
          </svg>
          RCLabs<span class="wordmark-label">/ products</span>
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(([path, label]) => (
            <a
              href={path}
              aria-current={Astro.url.pathname === path ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
          <a
            href="/demo/"
            class="button small"
            aria-current={Astro.url.pathname === '/demo/' ? 'page' : undefined}
          >
            {contact.cta} <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Toggle navigation">
            <Menu size={20} aria-hidden="true" />
          </summary>
          <nav aria-label="Mobile navigation">
            {navigation.map(([path, label]) => (
              <a href={path}>{label}</a>
            ))}
            <a href="/demo/">
              {contact.cta} <ArrowUpRight size={18} aria-hidden="true" />
            </a>
          </nav>
        </details>
      </header>
    </div>
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="shell site-footer">
      <a class="wordmark" href="/">
        RCLabs
      </a>
      <p>Tools for evidence and deliberate change.</p>
      <nav aria-label="Footer">
        <a href="/accessibility/">Accessibility</a>
        <a href="/privacy/">Privacy &amp; cookies</a>
        {analyticsMeasurementId && (
          <button type="button" id="privacy-settings-link">
            Cookie preferences
          </button>
        )}
        <a href="/demo/">Contact &amp; demo</a>
      </nav>
    </footer>
    <PrivacyConsent measurementId={analyticsMeasurementId} />
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => {
          menu.open = false;
        }),
      );
    </script>
  </body>
</html>
