---
import Layout from '../../layouts/Layout.astro';
import SearchDemo from '../../components/SearchDemo';
import Diagram from '../../components/Diagram.astro';
import Contact from '../../components/Contact.astro';
import { products } from '../../data/products';
const product = products[0];
---

<Layout
  title="Atheros Search - Find the evidence in your network data"
  description={product.summary}
  product="search"
>
  <section class="hero">
    <a class="breadcrumb" href="/">
      Products /
    </a>
    <p class="eyebrow">ATHEROS SEARCH / NETWORK EVIDENCE</p>
    <h1>
      Find the evidence
      <br />
      <span class="accent">in your network data.</span>
    </h1>
    <p class="lead">
      Move from a question to matching records, clear ranking explanations, and
      observed relationships. Keep the evidence and its limits in view.
    </p>
    <div class="actions">
      <a class="button" href="#demo">
        Try a sample investigation <span aria-hidden="true">&#8595;</span>
      </a>
      <a class="text-link" href="/demo/#search">
        Request a Search demo
      </a>
    </div>
  </section>
  <section id="demo" class="section demo-section">
    <div class="section-heading">
      <p class="eyebrow">AN INVESTIGATION YOU CAN EXPLORE</p>
      <h2>Ask. Inspect. Understand.</h2>
      <p>
        Choose a sample query, inspect its record, then open the explanation and
        relationship details. All data is synthetic.
      </p>
    </div>
    <SearchDemo client:load />
    <noscript>
      <p>
        JavaScript is off. The initial query and expandable explanation work as
        text; query switching needs JavaScript.
      </p>
    </noscript>
    <Diagram kind="search" />
  </section>
  <section class="section">
    <p class="eyebrow">MORE THAN A RESULT LIST</p>
    <h2>Give your investigation context.</h2>
    <div class="feature-grid">
      {product.features.map(([title, text], index) => (
        <article>
          <p class="feature-number">0{index + 1}</p>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section glossary">
    <h2>A few terms, made clear.</h2>
    <dl>
      <dt>Dense search</dt>
      <dd>
        Finds records with similar meaning using numerical representations
        called embeddings.
      </dd>
      <dt>Sparse search</dt>
      <dd>Finds records by matching terms.</dd>
      <dt>Hybrid search</dt>
      <dd>Combines meaning and term matches to rank results.</dd>
      <dt>Observed relationship</dt>
      <dd>
        A link supported by recorded observations. It does not prove a current
        connection or confirmed identity.
      </dd>
      <dt>ETL</dt>
      <dd>
        Extract, transform, load: the processing steps that prepare data for
        use.
      </dd>
    </dl>
  </section>
  <Contact product="Atheros Search" />
</Layout>
