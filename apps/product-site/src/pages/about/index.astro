---
import Layout from '../../layouts/Layout.astro';
import { about, author, email } from '../../data/products';
---

<Layout
  title={about.title}
  description={about.description}
  breadcrumbs={[
    { name: 'RCLabs', path: '/' },
    { name: 'About Rafael', path: '/about/' },
  ]}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1>{author.name}</h1>
      <p class="lead">{about.introduction}</p>
      <div class="actions">
        <a class="button primary" href={about.primaryCta.href}>
          {about.primaryCta.label}
        </a>
        <a class="text-link" href={about.secondaryCta.href}>
          {about.secondaryCta.label}
        </a>
      </div>
    </div>
  </section>
  <section class="section prose">
    <h2>{about.scopeTitle}</h2>
    <p>{about.scope}</p>
    <h2>{about.evidenceTitle}</h2>
    <p>{about.evidence}</p>
    <p>
      <a href={about.benchmarkCta.href}>{about.benchmarkCta.label}</a>.
    </p>
  </section>
  <section id="security" class="section prose" aria-labelledby="security-title">
    <h2 id="security-title">{about.securityTitle}</h2>
    {about.security.map(([heading, text]) => (
      <>
        <h3>{heading}</h3>
        <p>{text}</p>
      </>
    ))}
    <p>
      <a href={about.threatModelHref}>{about.threatModel}</a>.
    </p>
  </section>
  <section class="section prose">
    <h2>{about.contactTitle}</h2>
    <p>
      {about.contactSupporting}
      <!--email_off-->
      <a href={`mailto:${email}`}>{email}</a>
      <!--/email_off-->. Privacy requests go to the contact in the{' '}
      <a href={about.privacyLink.href}>{about.privacyLink.label}</a>.
    </p>
  </section>
</Layout>
