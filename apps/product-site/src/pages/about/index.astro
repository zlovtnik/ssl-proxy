---
import Layout from '../../layouts/Layout.astro';
import { ArrowRight, ArrowUpRight, Mail } from '@lucide/astro';
import { about, author, email, hiring } from '../../data/products';
import ProfessionalExperience from '../../components/ProfessionalExperience.astro';
import ProjectStudies from '../../components/ProjectStudies.astro';
---

<Layout
  title={about.title}
  description={about.description}
  breadcrumbs={[
    { name: 'RCLabs', path: '/' },
    { name: 'About Rafael', path: '/about/' },
  ]}
>
  <section class="hero about-hero" aria-labelledby="about-title">
    <div class="hero-copy">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1 id="about-title">{author.name}</h1>
      <p class="lead">{about.introduction}</p>
      <div class="actions">
        <a class="button primary" href={about.primaryCta.href}>
          {about.primaryCta.label} <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a class="text-link" href={about.secondaryCta.href}>
          {about.secondaryCta.label}{' '}
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
    <dl class="about-metrics" aria-label="Career and technical scope">
      {about.metrics.map(([value, label, detail]) => (
        <div>
          <dt>{value}</dt>
          <dd>
            <strong>{label}</strong>
            <span>{detail}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <ProfessionalExperience />

  <section class="section about-indexed-section" aria-labelledby="scope-title">
    <div class="about-section-header">
      <p class="about-index">{about.scope.index}</p>
      <h2 id="scope-title">{about.scope.title}</h2>
    </div>
    <ol class="about-scope-grid">
      {about.scope.domains.map((domain, index) => (
        <li>
          <article>
            <p class="about-item-index">0{index + 1}</p>
            <h3>{domain.title}</h3>
            <p>{domain.description}</p>
            <ul class="about-tags" aria-label={`${domain.title} technologies`}>
              {domain.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <ProjectStudies />

  <section
    class="section about-indexed-section about-prose-section"
    aria-labelledby="perspective-title"
  >
    <div class="about-section-header">
      <p class="about-index">{about.perspective.index}</p>
      <h2 id="perspective-title">{about.perspective.title}</h2>
    </div>
    <div class="about-prose">
      <p class="about-statement">{about.perspective.summary}</p>
      <ol class="about-principles">
        {about.perspective.principles.map(([title, description], index) => (
          <li>
            <span class="about-item-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="section about-indexed-section about-prose-section"
    aria-labelledby="contact-title"
  >
    <div class="about-section-header">
      <p class="about-index">{about.contact.index}</p>
      <h2 id="contact-title">{about.contact.title}</h2>
    </div>
    <div class="about-prose">
      <p class="about-statement">{about.contact.summary}</p>
      <dl class="about-signal-list">
        {about.contact.signals.map(([label, detail]) => (
          <div>
            <dt>{label}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <div class="actions">
        <!--email_off-->
        <a class="button primary" href={hiring.href}>
          <Mail size={18} aria-hidden="true" /> {hiring.cta}
        </a>
        <a class="text-link" href={`mailto:${email}`}>
          {email}
        </a>
        <!--/email_off-->
        <a class="text-link" href={author.profile}>
          github.com/zlovtnik <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="section about-evidence" aria-labelledby="evidence-title">
    <h2 id="evidence-title">{about.evidenceTitle}</h2>
    <p>{about.evidence}</p>
    <a class="text-link" href={about.threatModelHref}>
      {about.threatModel} <ArrowRight size={18} aria-hidden="true" />
    </a>
  </section>
</Layout>
