---
import Layout from '../../layouts/Layout.astro';
import { ArrowRight, ArrowUpRight, Mail } from '@lucide/astro';
import { about, author, email } from '../../data/products';
---

<Layout
  title={about.title}
  description={about.description}
  breadcrumbs={[
    { name: 'RCLabs', path: '/' },
    { name: 'About Rafael', path: '/about/' },
  ]}
>
  <section class="hero about-hero" aria-labelledby="about-title">
    <div class="hero-copy">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1 id="about-title">{author.name}</h1>
      <p class="lead">{about.introduction}</p>
      <div class="actions">
        <a class="button primary" href={about.primaryCta.href}>
          {about.primaryCta.label} <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a class="text-link" href={about.secondaryCta.href}>
          {about.secondaryCta.label}{' '}
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
    <dl class="about-metrics" aria-label="Career and technical scope">
      {about.metrics.map(([value, label, detail]) => (
        <div>
          <dt>{value}</dt>
          <dd>
            <strong>{label}</strong>
            <span>{detail}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section about-indexed-section" aria-labelledby="scope-title">
    <div class="about-section-header">
      <p class="about-index">{about.scope.index}</p>
      <h2 id="scope-title">{about.scope.title}</h2>
    </div>
    <ol class="about-scope-grid">
      {about.scope.domains.map((domain, index) => (
        <li>
          <article>
            <p class="about-item-index">0{index + 1}</p>
            <h3>{domain.title}</h3>
            <p>{domain.description}</p>
            <ul class="about-tags" aria-label={`${domain.title} technologies`}>
              {domain.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="section about-indexed-section" aria-labelledby="work-title">
    <div class="about-section-header about-section-header-wide">
      <p class="about-index">{about.selectedWork.index}</p>
      <div>
        <h2 id="work-title">{about.selectedWork.title}</h2>
        <p>{about.selectedWork.summary}</p>
      </div>
    </div>
    <div class="about-case-studies">
      {about.selectedWork.studies.map((study, index) => (
        <details class="about-case-study">
          <summary>
            <span class="about-case-index">0{index + 1}</span>
            <div class="about-case-intro">
              <h3 class="about-case-title">{study.title}</h3>
              <span class="about-case-kind">{study.kind}</span>
              <span class="about-case-summary">{study.summary}</span>
            </div>
            <span class="about-case-toggle" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="about-case-detail">
            <dl class="about-case-fields">
              <div>
                <dt>Problem</dt>
                <dd>{study.problem}</dd>
              </div>
              <div>
                <dt>Architecture</dt>
                <dd>{study.architecture}</dd>
              </div>
              <div>
                <dt>Decisions and trade-offs</dt>
                <dd>
                  <ul>
                    {study.decisions.map((decision) => (
                      <li>{decision}</li>
                    ))}
                  </ul>
                </dd>
              </div>
              {study.scope && (
                <div>
                  <dt>Scope and constraints</dt>
                  <dd>{study.scope}</dd>
                </div>
              )}
            </dl>
            {study.links.length > 0 && (
              <div class="about-case-links">
                {study.links.map((link) => (
                  <a class="text-link" href={link.href}>
                    {link.label} <ArrowUpRight size={18} aria-hidden="true" />
                  </a>
                ))}
              </div>
            )}
            {study.boundaries.length > 0 && (
              <div class="about-boundaries">
                <p class="about-boundaries-title">
                  Collection, evidence, and delivery boundaries
                </p>
                <dl class="about-case-fields">
                  {study.boundaries.map(([heading, text]) => (
                    <div>
                      <dt>{heading}</dt>
                      <dd>{text}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section
    class="section about-indexed-section about-prose-section"
    aria-labelledby="perspective-title"
  >
    <div class="about-section-header">
      <p class="about-index">{about.perspective.index}</p>
      <h2 id="perspective-title">{about.perspective.title}</h2>
    </div>
    <div class="about-prose">
      <p class="about-statement">{about.perspective.summary}</p>
      <ol class="about-principles">
        {about.perspective.principles.map(([title, description], index) => (
          <li>
            <span class="about-item-index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="section about-indexed-section about-prose-section"
    aria-labelledby="contact-title"
  >
    <div class="about-section-header">
      <p class="about-index">{about.contact.index}</p>
      <h2 id="contact-title">{about.contact.title}</h2>
    </div>
    <div class="about-prose">
      <p class="about-statement">{about.contact.summary}</p>
      <dl class="about-signal-list">
        {about.contact.signals.map(([label, detail]) => (
          <div>
            <dt>{label}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <div class="actions">
        <a class="button primary" href={`mailto:${email}`}>
          <Mail size={18} aria-hidden="true" /> {email}
        </a>
        <a class="text-link" href={author.profile}>
          github.com/zlovtnik <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="section about-evidence" aria-labelledby="evidence-title">
    <h2 id="evidence-title">{about.evidenceTitle}</h2>
    <p>{about.evidence}</p>
    <a class="text-link" href={about.threatModelHref}>
      {about.threatModel} <ArrowRight size={18} aria-hidden="true" />
    </a>
  </section>
</Layout>
