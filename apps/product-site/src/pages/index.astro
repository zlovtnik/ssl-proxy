---
import { ArrowRight, ArrowUpRight, Plus } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import ProductCards from '../components/ProductCards.astro';
import ProjectStudies from '../components/ProjectStudies.astro';
import ProfessionalExperience from '../components/ProfessionalExperience.astro';
import HiringContact from '../components/HiringContact.astro';
import {
  allProducts,
  email,
  author,
  home,
  guides,
  guidePath,
  guideIndex,
  hiring,
  portfolio,
} from '../data/products';
import '../styles/landing.css';

const origin = new URL('/', Astro.site ?? Astro.url);
// The portfolio publisher is a named person. This does not assert a company.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}#author`,
      name: author.name,
      url: new URL('/about/', origin).href,
      sameAs: [author.profile],
      email,
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      name: 'RCLabs',
      url: origin.toString(),
      publisher: { '@id': `${origin}#author` },
    },
  ],
};
---

<Layout
  title={home.title}
  description={home.description}
  product="landing"
  structuredData={structuredData}
>
  <section id="top" class="hero home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-stroke" aria-hidden="true" />
        {home.eyebrow}
      </p>
      <h1 id="hero-title">
        {home.headline[0]} <span class="accent">{home.headline[1]}</span>
      </h1>
      <p class="lead">{home.subheadline}</p>
      <div class="actions">
        <a class="button primary" href={home.primaryCta.href}>
          {home.primaryCta.label} <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a class="text-link" href={home.secondaryCta.href}>
          {home.secondaryCta.label}{' '}
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <!--email_off-->
        <a class="text-link" href={hiring.href}>
          {hiring.cta} <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <!--/email_off-->
      </div>
      <p class="hero-note">{home.supporting}</p>
    </div>
    <div class="hero-outline" aria-label="Engineering review path">
      {home.reviewPath.map((item) => (
        <a href={item.href}>
          <div>
            <strong class="outline-title">{item.title}</strong>
            <p>{item.text}</p>
          </div>
          <ArrowUpRight size={20} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
  <ProfessionalExperience />
  <ProjectStudies />
  <section
    id="technical-evidence"
    class="section"
    aria-labelledby="technical-evidence-title"
  >
    <div class="section-heading">
      <h2 id="technical-evidence-title">{portfolio.evidence.title}</h2>
      <p>{portfolio.evidence.summary}</p>
    </div>
    <div class="feature-grid">
      {portfolio.evidence.categories.map((category) => (
        <article>
          <h3>{category.title}</h3>
          <p>{category.text}</p>
        </article>
      ))}
    </div>
    <div class="actions">
      <a class="button primary" href={portfolio.evidence.metrics.href}>
        {portfolio.evidence.metrics.label}
        <ArrowRight size={18} aria-hidden="true" />
      </a>
      <a class="text-link" href={author.profile}>
        GitHub profile
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>
  <section
    id="products"
    class="section landing-products"
    aria-labelledby="products-title"
  >
    <div class="section-heading split">
      <div>
        <p class="eyebrow">{home.productsEyebrow}</p>
        <h2 id="products-title">{home.productsTitle}</h2>
      </div>
      <p>{home.productsSummary}</p>
    </div>
    <ProductCards />
    <div class="actions">
      <a class="text-link" href="/products/">
        Explore all projects <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section
    id="faq"
    class="section landing-faq"
    aria-labelledby="questions-title"
  >
    <div class="section-heading">
      <h2 id="questions-title">{home.faqTitle}</h2>
    </div>
    <div class="landing-faq-list">
      {home.faq.map((item) => (
        <details>
          <summary>
            {item.question}
            <Plus size={18} aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="section" id="guides" aria-labelledby="guides-title">
    <span id="approach" aria-hidden="true" />
    <span id="postgres-migration-review" aria-hidden="true" />
    <span id="technical-reference" aria-hidden="true" />
    <span id="workflow-comparison" aria-hidden="true" />
    <span id="search-benchmark" aria-hidden="true" />
    <div class="section-heading">
      <h2 id="guides-title">
        <a href="/guides/">{guideIndex.title}</a>
      </h2>
      <p>{guideIndex.summary}</p>
    </div>
    <div class="feature-grid guide-cards">
      {guides.map((item) => (
        <article>
          <h3>
            <a href={guidePath(item.slug)}>{item.title}</a>
          </h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>
  <HiringContact />
  <div id="contact" class="section">
    <Contact product={allProducts} />
  </div>
</Layout>
<script>
  const navigation = document.querySelectorAll(
    '.site-header nav a[href^="/#"]',
  );
  const activeSections = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navigation.forEach((link) => {
          if (link.getAttribute('href') === `/#${entry.target.id}`)
            link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-20% 0px -50% 0px' },
  );
  document
    .querySelectorAll(
      '#top, #experience, #selected-work, #technical-evidence, #products, #guides, #faq, #contact',
    )
    .forEach((section) => activeSections.observe(section));
</script>
