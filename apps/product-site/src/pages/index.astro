---
import { ArrowDown, ArrowUpRight, Plus } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import {
  email,
  author,
  home,
  guidePath,
  hiring,
  portfolio,
} from '../data/products';
import '../styles/landing.css';

const origin = new URL('/', Astro.site ?? Astro.url);
// The portfolio publisher is a named person. This does not assert a company.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}#author`,
      name: author.name,
      url: new URL('/about/', origin).href,
      sameAs: [author.profile],
      email,
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      name: 'RCLabs',
      url: origin.toString(),
      publisher: { '@id': `${origin}#author` },
    },
  ],
};
---

<Layout
  title={home.title}
  description={home.description}
  product="landing"
  structuredData={structuredData}
>
  <section id="top" class="hero home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 id="hero-title">
        {home.headline[0]} <span class="accent">{home.headline[1]}</span>
      </h1>
      <p class="lead">{home.subheadline}</p>
      <div class="actions">
        <a class="button primary" href={home.primaryCta.href}>
          {home.primaryCta.label} <ArrowDown size={14} aria-hidden="true" />
        </a>
        <a class="button" href={home.secondaryCta.href}>
          {home.secondaryCta.label}{' '}
          <ArrowUpRight size={14} aria-hidden="true" />
        </a>
      </div>
      <p class="hero-note">{home.supporting}</p>
    </div>
    <div class="hero-outline" aria-label="Engineering review path">
      <p class="eyebrow">{home.reviewTitle}</p>
      {home.reviewPath.map((item) => (
        <a href={item.href}>
          <div>
            <strong class="outline-title">
              {item.title} <ArrowUpRight size={14} aria-hidden="true" />
            </strong>
            <p>{item.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section
    id="experience"
    class="home-experience"
    aria-labelledby="experience-title"
  >
    <div>
      <p class="eyebrow">{home.experience.label}</p>
      <h2 id="experience-title">{home.experience.employer}</h2>
    </div>
    <div class="home-experience-copy">
      <p>{home.experience.summary}</p>
      <p class="fine-print">{home.experience.attribution}</p>
      <a class="text-link" href={home.experience.aboutLink.href}>
        {home.experience.aboutLink.label}{' '}
        <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    </div>
  </section>
  <section
    id="selected-work"
    class="section home-work"
    aria-labelledby="work-title"
  >
    <span id="products" aria-hidden="true" />
    <div class="section-heading">
      <p class="eyebrow">{home.workEyebrow}</p>
      <h2 id="work-title">{portfolio.workTitle}</h2>
      <p>{home.workSummary}</p>
    </div>
    <div class="home-project-grid">
      {home.projects.map((project) => (
        <article id={`case-${project.id}`} class="product-card home-project">
          <p class="eyebrow">{project.category}</p>
          <h3>{project.title}</h3>
          <p class="eyebrow project-stack">{project.stack}</p>
          <p>{project.summary}</p>
          <a class="text-link" href={project.link.href}>
            {project.link.label} <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          <p class="fine-print evidence-boundary">{project.caveat}</p>
        </article>
      ))}
    </div>
    <p class="fine-print">{home.sampleNote}</p>
  </section>
  <section
    id="technical-evidence"
    class="section home-evidence home-band"
    aria-labelledby="technical-evidence-title"
  >
    <div class="section-heading">
      <p class="eyebrow">{home.evidence.eyebrow}</p>
      <h2 id="technical-evidence-title">{home.evidence.title}</h2>
      <p>{home.evidence.summary}</p>
      <a class="text-link" href={author.profile}>
        {home.evidence.link}
        <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    </div>
  </section>
  <section
    class="section home-guides"
    id="guides"
    aria-labelledby="guides-title"
  >
    <span id="approach" aria-hidden="true" />
    <span id="postgres-migration-review" aria-hidden="true" />
    <span id="technical-reference" aria-hidden="true" />
    <span id="workflow-comparison" aria-hidden="true" />
    <span id="search-benchmark" aria-hidden="true" />
    <div class="section-heading">
      <p class="eyebrow">{home.guidesEyebrow}</p>
      <h2 id="guides-title">{home.guidesTitle}</h2>
    </div>
    <div class="feature-grid guide-cards">
      {home.guides.map((item) => (
        <article>
          <h3>
            <a href={guidePath(item.slug)}>
              {item.title} <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </h3>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href="/guides/">
      {home.guidesLink} <ArrowUpRight size={14} aria-hidden="true" />
    </a>
  </section>

  <section
    id="faq"
    class="section landing-faq"
    aria-labelledby="questions-title"
  >
    <div class="section-heading">
      <h2 id="questions-title">{home.faqTitle}</h2>
    </div>
    <div class="landing-faq-list">
      {home.faq.map((item) => (
        <details>
          <summary>
            {item.question}
            <Plus size={18} aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <!--email_off-->
  <section
    id="contact"
    class="section contact-banner home-contact home-band"
    aria-labelledby="contact-title"
  >
    <div id="employment">
      <p class="eyebrow">{home.contact.eyebrow}</p>
      <h2 id="contact-title">{home.contact.title}</h2>
      <p>{home.contact.summary}</p>
      <div class="actions">
        <a class="button primary" href={hiring.href}>
          {hiring.cta} <ArrowUpRight size={14} aria-hidden="true" />
        </a>
        <a class="button" href={home.contact.projects.href}>
          {home.contact.projects.label}{' '}
          <ArrowUpRight size={14} aria-hidden="true" />
        </a>
      </div>
      <a class="text-link" href={`mailto:${email}`}>
        {email} <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    </div>
  </section>
  <!--/email_off-->
</Layout>
<script>
  const navigation = document.querySelectorAll(
    '.site-header nav a[href^="/#"]',
  );
  const activeSections = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navigation.forEach((link) => {
          if (link.getAttribute('href') === `/#${entry.target.id}`)
            link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-20% 0px -50% 0px' },
  );
  document
    .querySelectorAll(
      '#top, #experience, #selected-work, #technical-evidence, #products, #guides, #faq, #contact',
    )
    .forEach((section) => activeSections.observe(section));
</script>
