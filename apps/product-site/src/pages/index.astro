---
import Layout from '../layouts/Layout.astro';
import LandingPlayground from '../components/LandingPlayground';
import {
  bothProducts,
  contact,
  email,
  home,
  products,
  demoLink,
} from '../data/products';
import '../styles/landing.css';
---

<Layout
  title="Investigate network evidence. Review database changes."
  description="Two independent tools from RCLabs. Atheros Search combines search results, ranking explanations, and recorded relationships. Schema Migrator validates ordered SQL and produces plans before execution. Explore both workflows with interactive, synthetic samples."
  product="landing"
>
  <section id="top" class="hero hero-split" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-stroke" aria-hidden="true" />
        TWO INDEPENDENT PRODUCTS
      </p>
      <h1 id="hero-title">
        {home.headline[0]}
        <span class="muted">{home.headline[1]}</span>
      </h1>
      <p class="lead">{home.subheadline}</p>
      <div class="actions">
        <a class="button primary" href={home.primaryCta.href}>
          {home.primaryCta.label} <span aria-hidden="true">&#8595;</span>
        </a>
        <a class="text-link" href={home.secondaryCta.href}>
          {home.secondaryCta.label} <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
      <p class="hero-note">{home.supporting}</p>
    </div>
    <div class="hero-proof">
      <LandingPlayground client:load />
    </div>
  </section>
  <section
    id="products"
    class="section landing-products"
    aria-labelledby="products-title"
  >
    <div class="landing-section-heading">
      <div>
        <p class="eyebrow">THE PRODUCTS / TWO INDEPENDENT TOOLS</p>
        <h2 id="products-title">
          Start with the job
          <br />
          you need to do.
        </h2>
      </div>
      <p>
        Different workflows.
        <br />
        The same attention to evidence.
      </p>
    </div>
    <div class="landing-product-grid">
      {products.map((product, index) => (
        <article class:list={['landing-product', product.id]}>
          <div class="product-index">
            <span>0{index + 1}</span>
            <p class="eyebrow">{product.label}</p>
          </div>
          <div class="landing-product-copy">
            <h3>{product.name}</h3>
            <p class="landing-promise">{product.promise}</p>
            <p>{product.summary}</p>
          </div>
          <div class="product-visual">
            {index === 0 ? (
              <div class="product-network">
                <span>Guest device 07</span>
                <span aria-hidden="true">&#8594;</span>
                <span>Lobby access point</span>
                <small>Observed relationship / identity unconfirmed</small>
              </div>
            ) : (
              <pre><code>{'-- dry-run plan / sample\n+ CREATE TABLE evidence_records\n+ CREATE INDEX observed_at\n! Review before execution'}</code></pre>
            )}
          </div>
          <ol class="landing-capabilities">
            {product.highlights.map(([title, text], number) => (
              <li>
                <span>0{number + 1}</span>
                <div>
                  <h4>{title}</h4>
                  <p>{text}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="product-links">
            <a
              class="text-link sample-link"
              href={`${product.path}#demo`}
              data-preview={product.id}
            >
              Try the {product.name} sample{' '}
              <span aria-hidden="true">&#8594;</span>
            </a>
            <a class="text-link" href={product.path}>
              Product details <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section
    id="approach"
    class="section landing-approach"
    aria-labelledby="approach-title"
  >
    <div class="landing-section-heading">
      <div>
        <p class="eyebrow">HOW THEY WORK</p>
        <h2 id="approach-title">The details stay visible.</h2>
      </div>
      <p>
        Each tool has its own workflow.
        <br />
        They do not share a live connection.
      </p>
    </div>
    <div class="landing-principles">
      <article>
        <span class="principle-index">[ 01 / INVESTIGATE ]</span>
        <h3>Evidence, with context.</h3>
        <p>
          An observed relationship is a lead to investigate. It does not confirm
          an active connection or a device identity.
        </p>
      </article>
      <article>
        <span class="principle-index">[ 02 / REVIEW ]</span>
        <h3>A plan you can inspect.</h3>
        <p>
          Offline checks and dry-run plans help you review a migration. SQL-file
          snapshots preserve the files, not the database.
        </p>
      </article>
      <article>
        <span class="principle-index">[ 03 / EXPLORE ]</span>
        <h3>Start with an interactive sample.</h3>
        <p>
          Try both workflows with synthetic records in your browser. No account,
          credentials, or database connection required.
        </p>
      </article>
    </div>
  </section>
  <section
    id="faq"
    class="section landing-faq"
    aria-labelledby="questions-title"
  >
    <div>
      <p class="eyebrow">A FEW PRACTICAL QUESTIONS</p>
      <h2 id="questions-title">Before you start.</h2>
      <p>Know what you're exploring.</p>
    </div>
    <div class="landing-faq-list">
      <details>
        <summary>
          Who are these tools for?<span aria-hidden="true">+</span>
        </summary>
        <p>
          {products.map((product) => (
            <>
              <strong>{product.name}</strong> {product.problem}{' '}
            </>
          ))}
        </p>
      </details>
      <details>
        <summary>
          Do the products work together?<span aria-hidden="true">+</span>
        </summary>
        <p>
          They are independent tools with separate workflows. There is no
          automatic connection between a network investigation and a database
          migration.
        </p>
      </details>
      <details>
        <summary>
          Does the sample change anything?<span aria-hidden="true">+</span>
        </summary>
        <p>
          No. The playground uses local, synthetic data. It does not connect to
          your systems or execute SQL against a database.
        </p>
      </details>
      <details>
        <summary>
          Can I try them with my own data?<span aria-hidden="true">+</span>
        </summary>
        <p>
          This public site uses synthetic data only.{' '}
          <a href="/demo/">{contact.cta}</a> to agree on the next step by email.
        </p>
      </details>
    </div>
  </section>
  <section id="contact" class="landing-contact" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">HAVE A USE CASE IN MIND?</p>
      <h2 id="contact-title">{contact.headline.join(' ')}</h2>
      <p>{contact.supporting}</p>
    </div>
    <a class="landing-contact-link" href={demoLink(bothProducts)}>
      <span>{contact.link}</span>
      <span aria-hidden="true">&#8599;</span>
      <small>{email}</small>
    </a>
  </section>
</Layout>
<script>
  const navigation = document.querySelectorAll(
    '.site-header nav a[href^="/#"]',
  );
  const activeSections = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navigation.forEach((link) => {
          if (link.getAttribute('href') === `/#${entry.target.id}`)
            link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-20% 0px -50% 0px' },
  );
  document
    .querySelectorAll('#top, #products, #approach, #faq, #contact')
    .forEach((section) => activeSections.observe(section));
</script>
