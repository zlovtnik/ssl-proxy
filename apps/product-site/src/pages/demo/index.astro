---
import Layout from '../../layouts/Layout.astro';
import { contact, demoLink, email } from '../../data/products';
const options = [
  [
    'search',
    'Atheros Search',
    'Explore network evidence and investigation context.',
  ],
  [
    'migrator',
    'Schema Migrator',
    'Review SQL files, dry-run plans, and run records.',
  ],
  [
    'both',
    'Both products',
    'Discuss the two separate tools in one conversation.',
  ],
];
---

<Layout
  title="Discuss your use case"
  description="Email RCLabs to discuss your use case for Atheros Search, Schema Migrator, or both. Tell us your environment and constraints; we agree on the next step by email."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">CONTACT / USE-CASE DISCUSSION</p>
      <h1>
        {contact.headline[0]}
        <span class="muted">{contact.headline[1]}</span>
      </h1>
      <p class="lead">{contact.supporting}</p>
    </div>
  </section>
  <section class="section" aria-labelledby="options-title">
    <div class="section-heading">
      <p class="eyebrow">CHOOSE A STARTING POINT</p>
      <h2 id="options-title">Which product should we discuss?</h2>
      <p>
        Each option opens an email request. Nothing is submitted through this
        site.
      </p>
    </div>
    <div class="feature-grid">
      {options.map(([id, name, text]) => (
        <article id={id}>
          <h3>{name}</h3>
          <p>{text}</p>
          <a
            class="button primary"
            href={demoLink(
              name === 'Both products'
                ? 'Atheros Search and Schema Migrator'
                : name,
            )}
          >
            Discuss {name}
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="section" aria-labelledby="address-title">
    <div class="section-heading">
      <p class="eyebrow">WRITE YOUR OWN</p>
      <h2 id="address-title">Prefer to write your own email?</h2>
      <p>Use this address. No information is submitted through this site.</p>
    </div>
    <div class="email-row">
      <a href={`mailto:${email}`}>{email}</a>
      <button type="button" id="copy-email">
        Copy email address
      </button>
    </div>
    <p id="copy-status" role="status" aria-live="polite"></p>
    <p>
      If an email app is not set up, select and copy the address into your usual
      email service.
    </p>
  </section>
  <script>
    document
      .getElementById('copy-email')
      ?.addEventListener('click', async () => {
        const status = document.getElementById('copy-status')!;
        try {
          await navigator.clipboard.writeText('rafael@rclabs.uk');
          status.textContent = 'Email address copied.';
          status.dataset.state = 'ok';
        } catch {
          status.textContent =
            'Copy is unavailable. Select the visible address and copy it manually.';
          status.dataset.state = 'error';
        }
      });
  </script>
</Layout>
