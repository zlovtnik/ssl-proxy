---
import Layout from '../../layouts/Layout.astro';
import MigratorDemo from '../../components/MigratorDemo';
import Diagram from '../../components/Diagram.astro';
import Contact from '../../components/Contact.astro';
import { products } from '../../data/products';
const product = products[1];
const eyebrow = `${product.name.toUpperCase()} / ${product.label}`;
---

<Layout
  title="Schema Migrator - Review SQL changes before you run them"
  description={product.summary}
  product="migrator"
>
  <section class="hero hero-split" aria-labelledby="hero-title">
    <div class="hero-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">RCLabs</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.name}</span>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">
        {product.headline[0]}
        <span class="accent">{product.headline[1]}</span>
      </h1>
      <p class="lead">{product.summary}</p>
      <div class="actions">
        <a class="button primary" href={product.primaryCta.href}>
          {product.primaryCta.label} <span aria-hidden="true">&#8595;</span>
        </a>
        <a class="text-link" href={product.secondaryCta.href}>
          {product.secondaryCta.label} <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
    <div class="hero-proof" id="demo">
      <MigratorDemo client:load />
      <noscript>
        <p class="fine-print">
          JavaScript is off. Expand "Read all steps as text" to explore the
          whole review.
        </p>
      </noscript>
    </div>
  </section>
  <section class="section" aria-labelledby="workflow-title">
    <div class="section-heading">
      <p class="eyebrow">HOW IT WORKS</p>
      <h2 id="workflow-title">From source files to a reviewable record.</h2>
      <p>
        Each step takes a defined input and produces something you can read. The
        public demonstration executes no SQL.
      </p>
    </div>
    <ol class="workflow-steps">
      {product.workflow.map((item, index) => (
        <li class="workflow-step">
          <span class="workflow-index">
            0{index + 1} / {item.step}
          </span>
          <h3>{item.step}</h3>
          <dl>
            <dt>Input</dt>
            <dd>{item.input}</dd>
            <dt>Processing</dt>
            <dd>{item.processing}</dd>
            <dt>Output</dt>
            <dd>{item.output}</dd>
          </dl>
        </li>
      ))}
    </ol>
  </section>
  <section class="section" aria-labelledby="value-title">
    <div class="section-heading">
      <p class="eyebrow">AUDIENCE VALUE</p>
      <h2 id="value-title">Two ways to assess Schema Migrator.</h2>
      <p>
        Both readings are published openly. Choose the one that matches your
        question.
      </p>
    </div>
    <div class="audience-grid">
      {product.audiences.map((audience) => (
        <article class="audience-card">
          <p class="eyebrow">{audience.title.toUpperCase()}</p>
          <h3>{audience.proposition}</h3>
          <ul class="checklist">
            {audience.points.map((point) => (
              <li>
                <span aria-hidden="true">&#10003;</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section class="section" aria-labelledby="evidence-title">
    <div class="section-heading">
      <p class="eyebrow">SUPPORTING CAPABILITY EVIDENCE</p>
      <h2 id="evidence-title">Mechanisms you can inspect.</h2>
      <p>
        These are working behaviours of the product, not projected savings,
        latency, or market claims.
      </p>
    </div>
    <div class="feature-grid">
      {product.features.map(([title, text], index) => (
        <article>
          <p class="feature-number">0{index + 1}</p>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
    <div class="two-column">
      <Diagram kind="migrator" />
      <div class="evidence-panel">
        <p class="eyebrow">SQL-FILE SNAPSHOTS / READ WITH CARE</p>
        <p class="caveat">{product.caveat}</p>
        <p class="fine-print">
          The sample review records are synthetic. It connects to no target and
          executes no SQL.
        </p>
      </div>
    </div>
  </section>
  <section class="section glossary" aria-labelledby="terms-title">
    <p class="eyebrow">GLOSSARY</p>
    <h2 id="terms-title">A few terms, made clear.</h2>
    <dl>
      {product.glossary.map(([term, definition]) => (
        <div>
          <dt>{term}</dt>
          <dd>{definition}</dd>
        </div>
      ))}
    </dl>
  </section>
  <Contact product={product.name} />
</Layout>
