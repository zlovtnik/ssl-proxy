---
import Layout from '../../layouts/Layout.astro';
import {
  contactOptions,
  discussionLink,
  email,
  hiring,
} from '../../data/products';
import HiringContact from '../../components/HiringContact.astro';
---

<Layout
  title="Contact Rafael - Backend engineering roles"
  description="Contact Rafael Cardoso about senior backend, integration, and data-pipeline roles."
>
  <section class="hero">
    <div class="hero-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">RCLabs</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contact</span>
      </nav>
      <p class="eyebrow">{hiring.eyebrow}</p>
      <h1>{hiring.pageTitle}</h1>
      <p class="lead">{hiring.pageSummary}</p>
    </div>
  </section>
  <HiringContact />
  <section class="section" aria-labelledby="options-title">
    <!--email_off-->
    <div class="section-heading">
      <h2 id="options-title">{hiring.projectsTitle}</h2>
      <p>{hiring.projectsSummary}</p>
      <p>{hiring.projectPrompt}</p>
    </div>
    <div class="feature-grid">
      {contactOptions.map((option) => (
        <article id={option.id}>
          <h3>{option.label}</h3>
          <p>{option.text}</p>
          <a class="button primary" href={discussionLink(option.subject)}>
            Ask about {option.label}
          </a>
        </article>
      ))}
    </div>
    <!--/email_off-->
  </section>
  <section class="section" aria-labelledby="address-title">
    <!--email_off-->
    <div class="section-heading">
      <h2 id="address-title">{hiring.addressTitle}</h2>
      <p>{hiring.addressSummary}</p>
    </div>
    <div class="email-row">
      <a href={`mailto:${email}`}>{email}</a>
      <button type="button" id="copy-email" data-email={email}>
        Copy email address
      </button>
    </div>
    <p id="copy-status" role="status" aria-live="polite"></p>
    <p>
      If an email app is not set up, select and copy the address into your usual
      email service.
    </p>
    <!--/email_off-->
  </section>
  <script>
    const copy = document.getElementById('copy-email');
    copy?.addEventListener('click', async () => {
      const status = document.getElementById('copy-status')!;
      try {
        await navigator.clipboard.writeText(
          (copy as HTMLButtonElement).dataset.email!,
        );
        status.textContent = 'Email address copied.';
        status.dataset.state = 'ok';
      } catch {
        status.textContent =
          'Copy is unavailable. Select the visible address and copy it manually.';
        status.dataset.state = 'error';
      }
    });
  </script>
</Layout>
