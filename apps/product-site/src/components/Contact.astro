---
import { demoLink } from '../data/products';
interface Props {
  product?: string;
}
const { product = 'Atheros Search and Schema Migrator' } = Astro.props;
---

<section class="contact-banner" aria-labelledby="contact-title">
  <p class="eyebrow">HAVE A USE CASE IN MIND?</p>
  <h2 id="contact-title">Discuss your use case.</h2>
  <p>
    Tell us what you need to investigate or change, your environment, and the
    constraints that matter. We'll agree on the next step by email.
  </p>
  <a class="button primary" href={demoLink(product)}>
    Discuss your use case <span aria-hidden="true">&#8599;</span>
  </a>
  <p class="fine-print">
    Opens your email app. A meeting is scheduled only after we agree on a time.
  </p>
</section>
