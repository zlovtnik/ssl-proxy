---
import { bothProducts, contact, demoLink } from '../data/products';
interface Props {
  product?: string;
}
const { product = bothProducts } = Astro.props;
---

<section class="contact-banner" aria-labelledby="contact-title">
  <p class="eyebrow">HAVE A USE CASE IN MIND?</p>
  <h2 id="contact-title">{contact.headline.join(' ')}</h2>
  <p>{contact.supporting}</p>
  <a class="button primary" href={demoLink(product)}>
    {contact.link} <span aria-hidden="true">&#8599;</span>
  </a>
  <p class="fine-print">
    Opens your email app. A meeting is scheduled only after we agree on a time.
  </p>
</section>
