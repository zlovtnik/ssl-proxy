---
import { demoLink } from '../data/products';
interface Props {
  product?: string;
}
const { product = 'Atheros Search and Schema Migrator' } = Astro.props;
---

<section class="contact-banner" aria-labelledby="contact-title">
  <p class="eyebrow">LET'S LOOK AT YOUR USE CASE</p>
  <h2 id="contact-title">Start with a conversation.</h2>
  <p>
    Tell us what you need to investigate or change. Request a guided demo by
    email.
  </p>
  <a class="button" href={demoLink(product)}>
    Email a demo request <span aria-hidden="true">&#8599;</span>
  </a>
  <p class="fine-print">
    Opens your email app. A meeting is scheduled only after we agree on a time.
  </p>
</section>
