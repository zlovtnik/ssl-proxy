---
import { allProducts, contact, demoLink, email } from '../data/products';
import { ArrowUpRight } from '@lucide/astro';
interface Props {
  product?: string;
}
const { product = allProducts } = Astro.props;
---

<!--email_off-->
<section class="contact-banner" aria-labelledby="contact-title">
  <p class="eyebrow">HAVE A USE CASE IN MIND?</p>
  <h2 id="contact-title">{contact.headline.join(' ')}</h2>
  <p>{contact.supporting}</p>
  <a class="button primary" href={demoLink(product)}>
    {contact.link} <ArrowUpRight size={18} aria-hidden="true" />
  </a>
  <p class="fine-print">
    Opens your email app, or write to <a href={`mailto:${email}`}>{email}</a>. A
    meeting is scheduled only after we agree on a time.
  </p>
</section>
<!--/email_off-->
