---
import snapshot from '../data/octopus-stats.json';
import OctopusOperationalStats from './OctopusOperationalStats';

interface Stats {
  asOf: string | null;
  source: {
    peaks: string;
    liveStrip: string;
    definition: string;
    timezone: string;
  };
  peakRecordsDay: number | null;
  peakRecordsDayDate: string | null;
  peakRecordsWeek: number | null;
  peakRecordsWeekStart: string | null;
  peakRecordsWeekEnd: string | null;
  liveStrip: {
    ingestProcessedRatePerSec: number;
    pendingLedgerCount: number;
    lastIngestSuccessAt: string | null;
    backpressureActive: boolean;
  } | null;
}
interface Props {
  stats?: Stats;
}
const { stats = snapshot } = Astro.props;
const statsUrl = import.meta.env.PUBLIC_OCTOPUS_STATS_URL as string | undefined;
const hasDay =
  stats.peakRecordsDay !== null && stats.peakRecordsDayDate !== null;
const hasWeek =
  stats.peakRecordsWeek !== null &&
  stats.peakRecordsWeekStart !== null &&
  stats.peakRecordsWeekEnd !== null;
---

<section
  id="operational-evidence"
  class="section ops-evidence"
  aria-labelledby="ops-title"
>
  <div class="section-heading">
    <h2 id="ops-title">Measured operational evidence</h2>
    <p>
      All-time peak ledger counts across ingest paths from production records.
    </p>
  </div>
  {(!hasDay || !hasWeek) && (
    <p class="fine-print">Numbers pending first measured refresh.</p>
  )}
  <OctopusOperationalStats
    client:visible
    initial={{
      asOf: stats.asOf ?? '',
      peaksComputedAt: null,
      peakRecordsDay: stats.peakRecordsDay,
      peakRecordsDayDate: stats.peakRecordsDayDate,
      peakRecordsWeek: stats.peakRecordsWeek,
      peakRecordsWeekStart: stats.peakRecordsWeekStart,
      peakRecordsWeekEnd: stats.peakRecordsWeekEnd,
      liveStrip: stats.liveStrip,
    }}
    statsUrl={statsUrl}
  />
  <p class="fine-print">Source: {stats.source.peaks}.</p>
  <p class="fine-print">
    {stats.source.definition} Timezone: {stats.source.timezone}.
  </p>
  <p class="fine-print">
    {stats.asOf ? (
      <>
        As of{' '}
        <time datetime={stats.asOf}>
          {stats.asOf.replace('T', ' ').replace('Z', '')} UTC
        </time>
        .
      </>
    ) : (
      'As of: pending first measured refresh.'
    )}
  </p>
</section>
