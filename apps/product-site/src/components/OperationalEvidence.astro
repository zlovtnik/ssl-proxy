---
import OctopusOperationalStats from './OctopusOperationalStats';
import { octopusMetrics } from '../data/products';
---

<section
  id="operational-evidence"
  class="section ops-evidence"
  aria-labelledby="ops-title"
>
  <div class="section-heading">
    <p class="eyebrow">{octopusMetrics.label}</p>
    <h2 id="ops-title">{octopusMetrics.title}</h2>
    <p>{octopusMetrics.summary}</p>
  </div>
  <OctopusOperationalStats client:load />
  <noscript>
    <p>{octopusMetrics.noScript}</p>
  </noscript>
  <details class="ops-method">
    <summary>{octopusMetrics.methodTitle}</summary>
    {octopusMetrics.method.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </details>
</section>
