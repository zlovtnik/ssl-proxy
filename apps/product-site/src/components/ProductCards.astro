---
import {
  ArrowRight,
  ArrowUpRight,
  Database,
  Network,
  Radio,
  Workflow,
} from '@lucide/astro';
import { products } from '../data/products';
const icons = {
  search: Radio,
  migrator: Database,
  vpn: Network,
  octopus: Workflow,
};
---

<div class="product-grid">
  {products.map((product) => {
    const Icon = icons[product.id];
    return (
      <article class:list={['product-card', product.id]}>
        <div class="product-card-top">
          <Icon size={26} stroke-width={1.5} aria-hidden="true" />
        </div>
        <div class="product-card-copy">
          <h2>{product.homeTitle}</h2>
          <p>{product.cardSummary}</p>
        </div>
        <div class="product-links">
          <a class="text-link" href={product.path}>
            {product.name} project details{' '}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          {product.id === 'octopus' ? (
            <a
              class="text-link"
              href={`${product.path}${product.primaryCta.href}`}
            >
              {product.primaryCta.label}{' '}
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          ) : (
            <a class="text-link sample-link" href={`${product.path}#demo`}>
              Try the {product.name} sample{' '}
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          )}
        </div>
      </article>
    );
  })}
</div>
