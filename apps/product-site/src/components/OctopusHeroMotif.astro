---
// Decorative octopus-style node/link graph for the Octopus hero.
// Ornamental only: not a topology or capacity claim.
---

<svg
  class="hero-motif"
  viewBox="0 0 360 360"
  aria-hidden="true"
  focusable="false"
>
  <g class="motif-links">
    <path class="motif-link" d="M180 180 C 150 120, 110 90, 48 62" />
    <path class="motif-link" d="M180 180 C 190 110, 210 70, 250 36" />
    <path class="motif-link" d="M180 180 C 230 150, 280 130, 330 98" />
    <path class="motif-link" d="M180 180 C 250 190, 300 210, 340 250" />
    <path class="motif-link" d="M180 180 C 220 230, 250 280, 280 330" />
    <path class="motif-link" d="M180 180 C 150 240, 120 290, 70 330" />
    <path class="motif-link" d="M180 180 C 110 200, 60 230, 22 280" />
    <path class="motif-link" d="M180 180 C 120 160, 70 150, 20 140" />
  </g>
  <g class="motif-nodes">
    <circle class="motif-node motif-core" cx="180" cy="180" r="16" />
    <circle class="motif-node" cx="48" cy="62" r="5" />
    <circle class="motif-node" cx="250" cy="36" r="5" />
    <circle class="motif-node" cx="330" cy="98" r="5" />
    <circle class="motif-node" cx="340" cy="250" r="5" />
    <circle class="motif-node" cx="280" cy="330" r="5" />
    <circle class="motif-node" cx="70" cy="330" r="5" />
    <circle class="motif-node" cx="22" cy="280" r="5" />
    <circle class="motif-node" cx="20" cy="140" r="5" />
  </g>
</svg>
