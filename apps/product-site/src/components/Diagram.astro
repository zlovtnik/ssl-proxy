---
import { getProduct, type ProductId } from '../data/products';
interface Props {
  kind: ProductId;
}
const { kind } = Astro.props;
const search = kind === 'search';
const vpn = kind === 'vpn';
const stages = search
  ? [
      ['Monitored site', 'sensor observations'],
      ['Wireless indicator', 'for analyst review'],
      ['Supporting', 'observations'],
    ]
  : vpn ? [
      ['WireGuard peer', 'configured ingress'],
      ['Proxy handling', 'category / policy'],
      ['Audit events', 'backend pipeline'],
    ] : [
      ['SQL files', 'and ordering'],
      ['Validate,', 'then dry-run'],
      ['Execution plan', 'and run record'],
    ];
const labels = search
  ? ['MONITORED SITE', 'INDICATOR', 'OBSERVATION']
  : ['INPUT', 'PROCESSING', 'OUTPUT'];
const centers = [100, 320, 540];
---

<figure class:list={['diagram', kind]}>
  <svg
    viewBox="0 0 640 170"
    role="img"
    aria-labelledby={`${kind}-diagram-title ${kind}-diagram-desc`}
  >
    <title id={`${kind}-diagram-title`}>
      {search
        ? 'Illustrative site, wireless indicator, and supporting observation path'
        : vpn ? 'WireGuard ingress, proxy handling, and audit publishing' : 'Schema Migrator input, processing, and output'}
    </title>
    <desc id={`${kind}-diagram-desc`}>
      {search
        ? 'Illustrative sample only: a monitored site, a configured wireless indicator for analyst review, and supporting wireless observations. It does not represent an end-to-end site overview in the current production console. An observation does not confirm a current connection or physical device identity.'
        : vpn ? 'Illustrative flow from a configured WireGuard peer through transparent proxy handling to audit publishing. Outcomes depend on configuration.' : 'Input: SQL files and ordering configuration. Processing: offline validation followed by a dry-run plan. Output: a proposed execution order and a run record. This is a review sequence, not an automatic execution.'}
    </desc>
    {[0, 1].map((index) => (
      <g class="diagram-arrow">
        <path
          d={`M${centers[index] + 95} 95 H${centers[index + 1] - 98}`}
          fill="none"
          stroke-width="2"
        />
        <path
          d={`M${centers[index + 1] - 106} 89 L${centers[index + 1] - 98} 95 L${centers[index + 1] - 106} 101`}
          fill="none"
          stroke-width="2"
        />
      </g>
    ))}
    {[0, 1, 2].map((index) => (
      <g>
        <text
          class="diagram-label"
          x={centers[index]}
          y="40"
          text-anchor="middle"
        >
          {labels[index]}
        </text>
        <rect x={centers[index] - 95} y="55" width="190" height="80" rx="8" />
        <g text-anchor="middle">
          <text x={centers[index]} y="90">
            {stages[index][0]}
          </text>
          <text x={centers[index]} y="112">
            {stages[index][1]}
          </text>
        </g>
      </g>
    ))}
  </svg>
  <figcaption>
    {search
      ? `Illustrative synthetic path from a monitored site to an indicator and its supporting observations. The current production console does not show this complete overview end to end. ${getProduct('search').caveat}`
      : vpn ? 'Configured WireGuard ingress, proxy handling, and audit publishing. The public demonstration sends no traffic.' : 'Input, processing, and output for a change review. The public demonstration executes no SQL.'}
  </figcaption>
</figure>
