---
interface Props {
  kind: 'search' | 'migrator';
}
const { kind } = Astro.props;
const search = kind === 'search';
const stages = search
  ? [
      ['Question', 'or exact terms'],
      ['Term, vector,', 'or hybrid rank'],
      ['Ranked records', 'with explanations'],
    ]
  : [
      ['SQL files', 'and ordering'],
      ['Validate,', 'then dry-run'],
      ['Execution plan', 'and run record'],
    ];
const labels = ['INPUT', 'PROCESSING', 'OUTPUT'];
const centers = [100, 320, 540];
---

<figure class:list={['diagram', kind]}>
  <svg
    viewBox="0 0 640 170"
    role="img"
    aria-labelledby={`${kind}-diagram-title ${kind}-diagram-desc`}
  >
    <title id={`${kind}-diagram-title`}>
      {search
        ? 'Atheros Search input, processing, and output'
        : 'Schema Migrator input, processing, and output'}
    </title>
    <desc id={`${kind}-diagram-desc`}>
      {search
        ? 'Input: a question or exact terms with filters. Processing: term matching, vector similarity, or hybrid ranking. Output: ranked observation records with explanations. Lines show the review sequence, not confirmed connections.'
        : 'Input: SQL files and ordering configuration. Processing: offline validation followed by a dry-run plan. Output: a proposed execution order and a run record. This is a review sequence, not an automatic execution.'}
    </desc>
    {[0, 1].map((index) => (
      <g class="diagram-arrow">
        <path
          d={`M${centers[index] + 95} 95 H${centers[index + 1] - 98}`}
          fill="none"
          stroke-width="2"
        />
        <path
          d={`M${centers[index + 1] - 106} 89 L${centers[index + 1] - 98} 95 L${centers[index + 1] - 106} 101`}
          fill="none"
          stroke-width="2"
        />
      </g>
    ))}
    {[0, 1, 2].map((index) => (
      <g>
        <text
          class="diagram-label"
          x={centers[index]}
          y="40"
          text-anchor="middle"
        >
          {labels[index]}
        </text>
        <rect x={centers[index] - 95} y="55" width="190" height="80" rx="8" />
        <g text-anchor="middle">
          <text x={centers[index]} y="90">
            {stages[index][0]}
          </text>
          <text x={centers[index]} y="112">
            {stages[index][1]}
          </text>
        </g>
      </g>
    ))}
  </svg>
  <figcaption>
    {search
      ? 'Input, processing, and output for an investigation. An observation does not confirm a current connection or device identity.'
      : 'Input, processing, and output for a change review. The public demonstration executes no SQL.'}
  </figcaption>
</figure>
