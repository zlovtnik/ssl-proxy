<% content_for :title, "Identities" %>
<% content_for :turbo_cache_control, "no-cache" %>

<h1>MAC Identity Inventory</h1>

<p>
  <%= link_to "Inventory CSV", inventory_identities_path(@inventory_query_parameters.merge(format: :csv)) %>
  |
  <%= link_to "Inventory JSON", inventory_identities_path(@inventory_query_parameters.merge(format: :json)) %>
</p>

<%= form_with url: identities_path, method: :get do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Search MAC, username, SSID, fingerprint, WPS" %>
  <%= form.submit "Search" %>
<% end %>

<div
  class="table-wrap"
  data-controller="mac-link"
  data-mac-link-inventory-url-value="<%= inventory_identities_path(format: :json) %>"
  data-mac-link-summary-url-value="<%= mac_summary_identities_path(format: :json) %>"
  data-mac-link-recent-audit-logs-url-value="<%= recent_audit_logs_path %>"
  data-mac-link-audit-logs-url-value="<%= audit_logs_path %>"
  data-mac-link-identities-url-value="<%= identities_path %>"
  data-mac-link-shadow-it-url-value="<%= shadow_it_alerts_path %>"
>
  <table>
    <thead>
      <tr>
        <th><%= sort_link_to "Last Occurred", :last_occurred_at %></th>
        <th>MAC</th>
        <th>BSSID</th>
        <th>Dest BSSID</th>
        <th>SSID</th>
        <th>Signal</th>
        <th>Location</th>
        <th>Username</th>
        <th>Registered</th>
        <th>Device</th>
        <th>WPS</th>
        <th>Fingerprint</th>
      </tr>
    </thead>
    <tbody>
      <% if @identities.any? %>
        <% @identities.each do |identity| %>
          <tr>
            <td><%= identity.last_occurred_at %></td>
            <td><%= identity.source_mac %></td>
            <td><%= identity.bssid %></td>
            <td><%= identity.destination_bssid %></td>
            <td><%= identity.ssid %></td>
            <td><%= identity.signal_dbm %></td>
            <td><%= identity.location_id %></td>
            <td><%= identity.username %></td>
            <td><%= identity.registered_username %></td>
            <td><%= identity.display_name || identity.device_id %></td>
            <td><%= identity.wps_device_name || identity.wps_model_name %></td>
            <td><%= identity.device_fingerprint&.first(12) %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="12" class="empty-state">No identities found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
</div>
