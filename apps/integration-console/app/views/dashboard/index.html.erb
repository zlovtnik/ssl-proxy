<% content_for :title, "Health" %>
<% content_for :turbo_cache_control, "no-cache" %>

<h1>Integration Console</h1>

<section class="grid grid-3">
  <% dashboard_cards = @dashboard_cards_payload || {} %>
  <% Array(dashboard_cards[:cards] || dashboard_cards["cards"]).each do |card| %>
    <% card = card.with_indifferent_access %>
    <% sparkline_path = metric_card_sparkline_path(card[:sparkline]) %>
    <article class="metric metric-card <%= metric_card_status_class(card[:status]) %>">
      <div class="metric-card-head">
        <div>
          <div class="metric-card-label"><%= card[:label] %></div>
          <div class="value" data-animate-morph="true"><%= card[:value] %></div>
          <% if card[:subValue].present? %>
            <div class="metric-card-subvalue"><%= card[:subValue] %></div>
          <% end %>
        </div>
      </div>
      <% if card[:trendLabel].present? %>
        <div class="metric-card-trend <%= metric_card_trend_class(card[:trend]) %>">
          <span aria-hidden="true"><%= metric_card_trend_symbol(card[:trend]) %></span>
          <span><%= card[:trendLabel] %></span>
        </div>
      <% end %>
      <% if sparkline_path.present? %>
        <svg class="metric-card-sparkline" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
          <path d="<%= sparkline_path %>" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
        </svg>
      <% end %>
    </article>
  <% end %>
</section>

<section class="grid grid-3 section-spaced">
  <div
    class="panel"
    data-controller="live-feed"
    data-live-feed-recent-url-value="<%= recent_audit_logs_path %>"
  >
    <h2>Live Heads-up Stream</h2>
    <div role="log" aria-live="polite" aria-relevant="additions text">
      <ul class="live-feed-list" data-live-feed-target="list">
        <li class="live-row live-row-empty">Waiting for audit events.</li>
      </ul>
    </div>
  </div>
  <div class="panel">
    <h2>NATS Throughput</h2>
    <% (@recent_samples || []).each do |subject, count| %>
      <p><strong><%= subject %></strong>: <%= count %> events in 5 minutes</p>
    <% end %>
  </div>
  <div class="panel">
    <h2>Recent Alerts</h2>
    <% (@recent_alerts || []).each do |alert| %>
      <p class="<%= status_class(alert.severity) %>"><%= alert.message %></p>
    <% end %>
  </div>
</section>

<section class="table-wrap section-spaced">
  <h2>Usable Sync Data</h2>
  <table>
    <thead>
      <tr>
        <th>Signal</th>
        <th>Source</th>
        <th>Value</th>
        <th>Detail</th>
        <th>Last Seen</th>
      </tr>
    </thead>
    <tbody>
      <% if (@sync_data_rows || []).any? %>
        <% @sync_data_rows.each do |row| %>
          <tr>
            <td><%= row[:label] %></td>
            <td><%= row[:source] %></td>
            <td><%= row[:value] %></td>
            <td><%= row[:detail] %></td>
            <td><%= row[:last_seen]&.to_fs(:db) || "n/a" %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="empty-state">No sync health data found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="table-wrap section-spaced">
  <h2>Important Relations</h2>
  <table>
    <thead>
      <tr>
        <th>Relation</th>
        <th>Kind</th>
        <th>Role</th>
        <th>Estimated Rows</th>
        <th>Size</th>
      </tr>
    </thead>
    <tbody>
      <% if (@sync_relation_rows || []).any? %>
        <% @sync_relation_rows.each do |row| %>
          <tr>
            <td><%= row[:name] %></td>
            <td><%= row[:kind] %></td>
            <td><%= row[:role] %></td>
            <td><%= number_with_delimiter(row[:estimated_rows]) %></td>
            <td><%= row[:total_size] %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="empty-state">No relation map found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="table-wrap section-spaced">
  <h2>Sensors</h2>
  <table>
    <thead>
      <tr>
        <th><%= sort_link_to "Sensor", :sensor_id %></th>
        <th><%= sort_link_to "Location", :location_id %></th>
        <th><%= sort_link_to "Last Seen", :last_seen_at %></th>
        <th><%= sort_link_to "Signal", :last_signal_dbm %></th>
        <th><%= sort_link_to "Status", :status %></th>
      </tr>
    </thead>
    <tbody>
      <% if (@sensors || []).any? %>
        <% @sensors.each do |sensor| %>
          <tr>
            <td><%= sensor.sensor_id %></td>
            <td><%= sensor.location_id %></td>
            <td><%= sensor.last_seen_at %></td>
            <td><%= sensor.last_signal_dbm %></td>
            <td class="<%= status_class(sensor.status) %>"><%= sensor.status %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="empty-state">No sensors found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
</section>
