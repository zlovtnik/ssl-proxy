# .env.example - Runtime wiring for docker compose
#
# Generate secrets and materialize a literal .env with:
#   scripts/gen-secrets generate
#   scripts/gen-secrets env
#
# Never commit .env or secrets/ to version control.

# Local registry images
REGISTRY=<server-local-ip>:5000
IMAGE_TAG=latest

# TiDB (MySQL-compatible)
TIDB_PASSWORD=

# MinIO
MINIO_ACCESS_KEY_ID=<generated by scripts/gen-secrets env>
MINIO_SECRET_ACCESS_KEY=<generated by scripts/gen-secrets env>

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=<generated by scripts/gen-secrets env>

# Atheros search API token hash. The raw token is written once to secrets/ONE_TIME_TOKENS.
ATHSEARCH_API_TOKEN_SHA256=<generated by scripts/gen-secrets env>

# ssl-proxy admin key (file-based via _FILE variant; env var explicitly empty)
ADMIN_API_KEY=
ADMIN_API_KEY_FILE=/run/local-secrets/admin_api_key

# WireGuard obfuscation key (file-based via _FILE variant)
WG_OBFUSCATION_KEY=
WG_OBFUSCATION_KEY_FILE=/run/local-secrets/wg_obfuscation_key

# WAHA credentials
WAHA_NO_API_KEY=False
WAHA_API_KEY="<generated by scripts/gen-secrets env>"
WAHA_API_KEY_FILE=
WAHA_DASHBOARD_NO_PASSWORD=False
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=<generated by scripts/gen-secrets env>
WHATSAPP_SWAGGER_NO_PASSWORD=False
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=<generated by scripts/gen-secrets env>
