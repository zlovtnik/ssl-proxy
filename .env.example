# .env.example — Runtime wiring for docker compose
#
# Copy this to .env and populate from secrets/:
#   perl scripts/gen-secrets.pl   # one-time generation
#   cp .env.example .env
#   $EDITOR .env
#
# Never commit .env or secrets/ to version control.

# Postgres
POSTGRES_PASSWORD=$(cat secrets/postgres.key)

# MinIO
MINIO_ACCESS_KEY_ID=$(cat secrets/minio_access_key.key)
MINIO_SECRET_ACCESS_KEY=$(cat secrets/minio_secret_key.key)

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=$(cat secrets/grafana_admin_password.key)

# Atheros search API token (SHA-256 hash only — not the raw token)
ATHSEARCH_API_TOKEN_SHA256=$(cat secrets/atheros_api_token_sha256.key)

# ssl-proxy admin key (file-based via _FILE variant; env var explicitly empty)
ADMIN_API_KEY=
ADMIN_API_KEY_FILE=/run/local-secrets/admin_api_key

# WireGuard obfuscation key (file-based via _FILE variant)
WG_OBFUSCATION_KEY=
WG_OBFUSCATION_KEY_FILE=/run/local-secrets/wg_obfuscation_key

# Waha credentials
WAHA_API_KEY=$(cat secrets/waha/api_key.key)
WAHA_DASHBOARD_PASSWORD=$(cat secrets/waha/dashboard_password.key)
WHATSAPP_SWAGGER_PASSWORD=$(cat secrets/waha/swagger_password.key)