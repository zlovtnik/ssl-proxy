-- Atheros Search can calculate ETL health and serve alerts, but it cannot read
-- operator credentials or registered-device claims.
GRANT SELECT ON octopus_core.schema_readiness TO {{ATHEROS_SEARCH_ACCOUNT}};
GRANT SELECT ON octopus_core.consumer_checkpoints TO {{ATHEROS_SEARCH_ACCOUNT}};
GRANT SELECT ON octopus_core.ingestion_receipts TO {{ATHEROS_SEARCH_ACCOUNT}};
GRANT SELECT (
  work_id, work_kind, status, priority, lease_expires_at,
  attempt_count, max_attempts, next_attempt_at,
  created_at, started_at, finished_at, updated_at
) ON octopus_core.work_items TO {{ATHEROS_SEARCH_ACCOUNT}};
