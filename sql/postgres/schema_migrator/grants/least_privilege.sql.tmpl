-- Provision the state account and its credential outside schema migration.
-- External target credentials are separate and receive no grants here.

GRANT USAGE ON SCHEMA schema_migrator TO {{SCHEMA_MIGRATOR_STATE_ACCOUNT}};
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA schema_migrator
  TO {{SCHEMA_MIGRATOR_STATE_ACCOUNT}};
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA schema_migrator
  TO {{SCHEMA_MIGRATOR_STATE_ACCOUNT}};
