[Unit]
Description=Atheros AR9271 wireless audit sensor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ssl-proxy/services/atheros-sensor
Environment=ATH_SENSOR_LOCATION_ID=North-Wing-Entry
Environment=ATH_SENSOR_CHANNEL=6
Environment=ATH_SENSOR_CHANNEL_HOP_ENABLED=false
Environment=ATH_SENSOR_CHANNEL_HOP_INTERVAL_MS=1000
Environment=ATH_SENSOR_REG_DOMAIN=US
Environment=ATH_SENSOR_CLIENT_INVENTORY_FLUSH_SECS=60
Environment=ATH_SENSOR_SIGNAL_ANOMALY_DBM_DELTA=15
Environment=ATH_SENSOR_DEAUTH_FLOOD_THRESHOLD=20
Environment=ATH_SENSOR_DEAUTH_FLOOD_WINDOW_SECS=30
Environment=ATH_SENSOR_DEAUTH_FLOOD_COOLDOWN_SECS=60
Environment=ATH_SENSOR_EXPORT_HANDSHAKES=false
Environment=ATH_SENSOR_AUTHORIZED_NETWORK_CACHE_TTL_SECS=60
Environment=ATH_SENSOR_SHUTDOWN_GRACE_SECS=5
Environment=ATH_SENSOR_AUDIT_LAYER_STREAM=off
Environment=RUST_LOG=warn,atheros_sensor=info,ssl_proxy=info
Environment=SYNC_REDPANDA_BOOTSTRAP_SERVERS=redpanda://127.0.0.1:19092
ExecStartPre=/opt/ssl-proxy/scripts/prep_ath.sh
ExecStart=/opt/ssl-proxy/services/atheros-sensor/target/release/atheros-sensor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
