{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "rolloutRevision": { "type": "string" },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "automountServiceAccountToken": { "type": "boolean" }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostPorts": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "hostPort": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65535
        },
        "sharedMemory": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$"
            }
          }
        }
      }
    },
    "integrationConsole": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "web": {
          "type": "object",
          "properties": {
            "service": {
              "type": "object",
              "properties": {
                "hostPort": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    },
    "schemaMigrator": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "publicHostname": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
        },
        "backend": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            },
            "resources": { "type": "object" }
          }
        },
        "ui": {
          "type": "object",
          "properties": {
            "browserOrigin": {
              "type": "string",
              "pattern": "^$|^https?://[^/]+$"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            },
            "service": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "hostPort": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "resources": { "type": "object" }
          }
        },
        "stateStore": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "databaseName": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 },
            "schema": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "poolSize": { "type": "integer", "minimum": 1 },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "passwordKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "keycloak": {
          "type": "object",
          "properties": {
            "realm": { "type": "string", "minLength": 1 },
            "clientId": { "type": "string", "minLength": 1 }
          }
        },
        "traefik": {
          "type": "object",
          "properties": {
            "hostPorts": {
              "type": "object",
              "properties": {
                "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "https": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "lan": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "acme": {
              "type": "object",
              "properties": {
                "email": { "type": "string" },
                "server": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    },
    "tidb": {
      "type": "object",
      "properties": {
        "external": { "type": "boolean" },
        "persistence": {
          "type": "object",
          "properties": {
            "hostPath": { "type": "string" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaMigrator": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["schemaMigrator"]
      },
      "then": {
        "properties": {
          "schemaMigrator": {
            "required": ["publicHostname", "traefik"],
            "properties": {
              "publicHostname": { "minLength": 1 },
              "traefik": {
                "required": ["acme"],
                "properties": {
                  "acme": {
                    "required": ["email"],
                    "properties": {
                      "email": {
                        "minLength": 3,
                        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
