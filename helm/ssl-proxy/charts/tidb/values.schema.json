{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["external", "minimumVersion", "egress", "memoryTuning"],
  "properties": {
    "external": {"type": "boolean"},
    "minimumVersion": {"type": "string", "pattern": "^8\\.(?:[5-9]|[1-9][0-9])(?:\\.[0-9]+)?$"},
    "memoryTuning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statsCacheQuotaBytes",
        "schemaCacheSizeBytes",
        "coprocessorCacheCapacityMB"
      ],
      "properties": {
        "statsCacheQuotaBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "schemaCacheSizeBytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 9223372036854775807
        },
        "coprocessorCacheCapacityMB": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "egress": {
      "type": "object",
      "required": ["enabled", "cidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "cidrs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
