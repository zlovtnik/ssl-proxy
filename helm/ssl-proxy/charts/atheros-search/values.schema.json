{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "replicas": { "type": "integer", "minimum": 1 },
    "embeddingBackend": { "type": "string" },
    "embeddingDimensions": { "type": "integer", "const": 768 },
    "apiTokenEnabled": { "type": "boolean" },
    "worker": {
      "type": "object",
      "required": ["enabled", "batchSize", "requestBatchSize", "requestBatchMax"]
    },
    "ui": {
      "type": "object",
      "required": ["enabled", "image", "service", "resources"]
    }
  },
  "required": ["enabled", "image", "service", "worker", "ui"]
}
