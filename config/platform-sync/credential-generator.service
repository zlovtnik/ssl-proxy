[Unit]
Description=Platform sync credential generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/platform-sync/platform-sync.conf
LoadCredential=k3s-kubeconfig:/etc/rancher/k3s/k3s.yaml
Environment=KUBECONFIG=%d/k3s-kubeconfig
ExecStart=/opt/platform-sync/bin/cred-gen
RuntimeDirectory=platform-sync
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

User=platform-sync
Group=platform-sync

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/platform-sync
CapabilityBoundingSet=
