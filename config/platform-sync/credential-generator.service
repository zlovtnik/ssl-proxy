[Unit]
Description=Platform sync credential generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/platform-sync/platform-sync.conf
ExecStartPre=/usr/bin/mkdir -p /run/platform-sync
ExecStart=/opt/platform-sync/bin/cred-gen
ExecStartPost=/bin/chmod 600 /run/platform-sync/kubeconfig /run/platform-sync/vault-token
RemainAfterExit=yes

User=platform-sync
Group=platform-sync

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/platform-sync
CapabilityBoundingSet=
