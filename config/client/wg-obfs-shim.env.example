# WARNING: The obfuscation key below is a placeholder. Replace with the actual
# key from secrets/wg_obfuscation_key on the server. Never commit the real value.
# The key must be at least 32 bytes; shorter keys are rejected.
#
# Real remote server endpoint that the shim forwards to.
WG_OBFS_SERVER_ADDR=192.168.1.242:443
# Optional comma-separated failover list. Overrides WG_OBFS_SERVER_ADDR when set.
# WG_OBFS_SERVER_ADDRS=192.168.1.242:443,192.168.1.222:443

# Local endpoint that the WireGuard client points to.
WG_OBFS_SHIM_LISTEN_ADDR=127.0.0.1:51821

# Local HTTP readiness endpoint. GET /health returns {"status":"ok","sessions":N}.
# WG_OBFS_HEALTH_ADDR=127.0.0.1:51822

# Must match the server-side configuration exactly. The v2 frame format derives
# all per-frame keys from this value via HKDF; there is no magic byte anymore.
WG_OBFUSCATION_KEY=replace-with-rotator-generated-obfuscation-key
WG_OBFUSCATION_SESSION_IDLE_SECS=300

# Shim resource controls. Leave empty/unset to use the binary defaults.
# WG_OBFS_SHIM_MAX_SESSIONS=1024
# WG_OBFS_SHIM_CLEANUP_INTERVAL_SECS=5
# WG_OBFS_SHIM_DRAIN_TIMEOUT_SECS=5
# WG_OBFS_SHIM_RATE_LIMIT_PPS=500
# WG_OBFS_SHIM_RATE_LIMIT_BURST=100
# WG_OBFS_SHIM_BUFFER_POOL_CAPACITY=1024
# WG_OBFS_SHIM_SEND_QUEUE_CAPACITY=1024
# WG_OBFUSCATION_MAX_DATAGRAM_BYTES=1500
# WG_UDP_SOCKET_BUFFER_BYTES=16777216
# WG_OBFS_SHIM_METRICS_ADDR=127.0.0.1:9900

# v2 frame format hardening. The default is AEAD (XChaCha20-Poly1305) with
# mandatory, salt-keyed replay protection. The server relay must use matching
# values. WG_OBFUSCATION_MAGIC_BYTE is no longer supported and fails closed.
# WG_OBFUSCATION_ENCRYPTION_MODE=aead
# WG_OBFUSCATION_PADDING=none
# With framed AEAD, reduce the WireGuard profile MTU to account for the
# 30-byte frame header, 2-byte body length, and 16-byte AEAD tag.

# Optional logging override.
RUST_LOG=wg_obfs_shim=info