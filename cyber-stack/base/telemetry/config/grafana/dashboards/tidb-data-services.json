{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"TiDB & Data Services","uid":"tidb-data-services","time":{"from":"now-6h","to":"now"},"panels":[
    {"id":1,"type":"stat","title":"TiDB Up","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(up{service=\"tidb\"})"}]},
    {"id":2,"type":"timeseries","title":"TiDB QPS and Errors","gridPos":{"x":6,"y":0,"w":18,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(tidb_server_query_total[5m])) by (result)"},{"refId":"B","expr":"sum(rate(tidb_server_query_total{result!=\"OK\"}[5m]))"}]},
    {"id":3,"type":"timeseries","title":"TiDB Query Latency p95","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(tidb_server_handle_query_duration_seconds_bucket[5m])))"}]},
    {"id":4,"type":"timeseries","title":"Connections and Transactions","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"tidb_server_connections"},{"refId":"B","expr":"sum(rate(tidb_session_transaction_duration_seconds_count[5m]))"}]},
    {"id":5,"type":"timeseries","title":"Deadlocks and Locks","gridPos":{"x":0,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(tidb_server_deadlock_total[5m]))"},{"refId":"B","expr":"sum(rate(tidb_transaction_local_latch_wait_duration_seconds_count[5m]))"}]},
    {"id":6,"type":"timeseries","title":"Application Database Pools","gridPos":{"x":8,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"db_client_connections_usage"},{"refId":"B","expr":"rate(db_client_operation_duration_seconds_count[5m])"}]},
    {"id":7,"type":"timeseries","title":"Redis","gridPos":{"x":16,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"redis_connected_clients"},{"refId":"B","expr":"rate(redis_commands_processed_total[5m])"},{"refId":"C","expr":"redis_memory_used_bytes"}]},
    {"id":8,"type":"timeseries","title":"MinIO","gridPos":{"x":0,"y":24,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(minio_s3_requests_total[5m])) by (api)"},{"refId":"B","expr":"sum(minio_cluster_capacity_usable_free_bytes)"}]}
  ]
}
