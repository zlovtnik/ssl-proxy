{
  "uid": "redpanda-cluster",
  "title": "Redpanda Cluster",
  "schemaVersion": 39,
  "editable": false,
  "time": {"from": "now-6h", "to": "now"},
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "row", "title": "Cluster Health", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 2, "type": "stat", "title": "Broker Count", "description": "The cluster-reported broker count. This stays at one even though Prometheus scrapes two metric paths.", "gridPos": {"x": 0, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(redpanda_cluster_brokers) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"id": 3, "type": "stat", "title": "Public Metrics Scrape", "gridPos": {"x": 4, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(up{job=\"ssl-proxy-redpanda\"}) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}, "overrides": []}},
    {"id": 4, "type": "stat", "title": "Unavailable Partitions", "gridPos": {"x": 8, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(redpanda_cluster_unavailable_partitions) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}},
    {"id": 5, "type": "stat", "title": "Broker Disk Alert", "description": "Redpanda uses the shared host root filesystem.", "gridPos": {"x": 12, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(redpanda_storage_disk_free_space_alert) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Clear", "color": "green"}, "1": {"text": "Low space", "color": "red"}}}]}, "overrides": []}},
    {"id": 6, "type": "stat", "title": "Kafka Topics", "gridPos": {"x": 16, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "count(redpanda_kafka_partitions{redpanda_namespace=\"kafka\"}) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}},
    {"id": 7, "type": "stat", "title": "Cluster Partitions", "description": "In this one-broker cluster every partition is led by the sole broker.", "gridPos": {"x": 20, "y": 1, "w": 4, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(redpanda_cluster_partitions) or vector(0)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Kafka Throughput", "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (redpanda_request) (rate(redpanda_kafka_request_bytes_total{redpanda_request=~\"produce|consume\"}[5m]))", "legendFormat": "{{redpanda_request}}"}, {"refId": "B", "expr": "topk(10, sum by (redpanda_topic) (rate(redpanda_kafka_request_bytes_total{redpanda_request=\"produce\"}[5m])))", "legendFormat": "{{redpanda_topic}} produce"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 9, "type": "timeseries", "title": "Request p99 Latency and Errors", "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (le, redpanda_request) (rate(redpanda_kafka_request_latency_seconds_bucket[5m])))", "legendFormat": "{{redpanda_request}} p99 latency"}, {"refId": "B", "expr": "sum by (redpanda_server) (rate(redpanda_rpc_request_errors_total[5m]))", "legendFormat": "{{redpanda_server}} errors/s"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".*errors/s"}, "properties": [{"id": "unit", "value": "ops"}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 10, "type": "timeseries", "title": "Produce Records per Second", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(10, sum by (redpanda_topic) (clamp_min(deriv(redpanda_kafka_max_offset{redpanda_namespace=\"kafka\"}[5m]), 0)))", "legendFormat": "{{redpanda_topic}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 11, "type": "timeseries", "title": "Consumer Lag by Group and Topic", "description": "Derived from per-partition max and committed offsets; the current wireless audit projector is not a Kafka consumer group.", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (redpanda_group, redpanda_topic) (clamp_min(-(redpanda_kafka_consumer_group_committed_offset - on (redpanda_topic, redpanda_partition) group_left redpanda_kafka_max_offset{redpanda_namespace=\"kafka\"}), 0))", "legendFormat": "{{redpanda_group}} / {{redpanda_topic}}"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 5000}, {"color": "red", "value": 20000}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 12, "type": "timeseries", "title": "Shared Disk and Redpanda Memory", "description": "Disk free space is on the host root filesystem shared with Redpanda's local-path volume.", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "min(redpanda_storage_disk_free_bytes) or vector(0)", "legendFormat": "shared host disk free"}, {"refId": "B", "expr": "max(vectorized_memory_allocated_memory) or vector(0)", "legendFormat": "Redpanda allocated memory"}, {"refId": "C", "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"prod-ssl-proxy\",pod=~\"ssl-proxy-redpanda-.*\",container=\"\",image=\"\",id=~\".*pod.*\"}) or vector(0)", "legendFormat": "{{pod}} cgroup working set"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 13, "type": "timeseries", "title": "CPU Busy per Shard", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(redpanda_cpu_busy_seconds_total[5m])", "legendFormat": "shard {{shard}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 14, "type": "timeseries", "title": "Reactor Stalls", "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(vectorized_stall_detector_reported[5m])) or vector(0)", "legendFormat": "reported stalls/s"}, {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(vectorized_reactor_stalls_bucket[5m]))) or vector(0)", "legendFormat": "p99 stall duration"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "p99 stall duration"}, "properties": [{"id": "unit", "value": "µs"}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 15, "type": "stat", "title": "Topic Inventory Age", "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - max(redpanda_topic_inventory_last_success_unixtime)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1200}, {"color": "red", "value": 1800}]}}, "overrides": []}},
    {"id": 16, "type": "row", "title": "Per-topic Disk and Retention", "gridPos": {"x": 0, "y": 38, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 17, "type": "bargauge", "title": "Largest Topics", "gridPos": {"x": 0, "y": 39, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(15, redpanda_topic_log_bytes) or vector(0)", "legendFormat": "{{topic}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 18, "type": "timeseries", "title": "Topic Bytes Growth", "gridPos": {"x": 8, "y": 39, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(10, deriv(redpanda_topic_log_bytes[1h])) or vector(0)", "legendFormat": "{{topic}}"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 19, "type": "bargauge", "title": "Topic Bytes / Retention Cap", "gridPos": {"x": 16, "y": 39, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(15, redpanda_topic_log_bytes / on (topic) ((redpanda_topic_retention_bytes > 0) * on (topic) label_replace(redpanda_kafka_partitions{redpanda_namespace=\"kafka\"}, \"topic\", \"$1\", \"redpanda_topic\", \"(.*)\"))) or vector(0)", "legendFormat": "{{topic}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 20, "type": "timeseries", "title": "Estimated Retention Days at Current Produce Rate", "gridPos": {"x": 0, "y": 47, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(10, redpanda_topic_log_bytes / on (topic) group_left label_replace(sum by (redpanda_topic) (rate(redpanda_kafka_request_bytes_total{redpanda_request=\"produce\"}[5m])) > 0, \"topic\", \"$1\", \"redpanda_topic\", \"(.*)\") / 86400) or vector(0)", "legendFormat": "{{topic}}"}], "fieldConfig": {"defaults": {"unit": "d"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 21, "type": "timeseries", "title": "Configured Per-partition Retention Bytes", "gridPos": {"x": 12, "y": 47, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "redpanda_topic_retention_bytes or vector(0)", "legendFormat": "{{topic}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 22, "type": "row", "title": "Daily Prefix Maintenance", "gridPos": {"x": 0, "y": 55, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 23, "type": "stat", "title": "Last Maintenance Run Age", "gridPos": {"x": 0, "y": 56, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - max(redpanda_maint_last_run_timestamp_seconds)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 86400}, {"color": "red", "value": 93600}]}}, "overrides": []}},
    {"id": 24, "type": "stat", "title": "Maintenance Dry-run", "gridPos": {"x": 6, "y": 56, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(redpanda_maint_dry_run)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Apply", "color": "green"}, "1": {"text": "Dry-run", "color": "orange"}}}]}, "overrides": []}},
    {"id": 25, "type": "table", "title": "Per-topic Maintenance Status", "gridPos": {"x": 12, "y": 56, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "redpanda_maint_topic_status", "legendFormat": "{{topic}}", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}},
    {"id": 26, "type": "bargauge", "title": "Planned or Trimmed Records", "gridPos": {"x": 0, "y": 61, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "redpanda_maint_trim_records", "legendFormat": "{{topic}}", "instant": true}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 27, "type": "bargauge", "title": "Maintained Topic Bytes", "gridPos": {"x": 12, "y": 61, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "redpanda_topic_log_bytes{topic=~\"wireless.audit|sync.scan.request\"}", "legendFormat": "{{topic}}", "instant": true}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}}
  ]
}
