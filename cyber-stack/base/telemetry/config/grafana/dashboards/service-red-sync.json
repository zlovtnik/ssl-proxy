{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"Service RED & Sync Pipeline","uid":"service-red-sync","time":{"from":"now-6h","to":"now"},
  "templating":{"list":[{"name":"service","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(up, service)"},"includeAll":true,"multi":true,"current":{"text":"All","value":"$__all"}}]},
  "panels":[
    {"id":1,"type":"timeseries","title":"Request Rate","gridPos":{"x":0,"y":0,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"service:http_requests:rate5m{service=~\"$service\"}"},{"refId":"B","expr":"athsearch:requests:rate5m"}]},
    {"id":2,"type":"timeseries","title":"Error Ratio","gridPos":{"x":8,"y":0,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"service:http_errors:ratio_rate5m{service=~\"$service\"}"},{"refId":"B","expr":"sum(rate(athsearch_search_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(athsearch_search_requests_total[5m])), 0.001)"}]},
    {"id":3,"type":"timeseries","title":"Latency p95","gridPos":{"x":16,"y":0,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"service:http_latency:p95_5m{service=~\"$service\"}"},{"refId":"B","expr":"athsearch:latency:p95_5m / 1000"}]},
    {"id":4,"type":"timeseries","title":"Proxy Classifications","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (category) (rate(ssl_proxy_classifications_total[5m]))","legendFormat":"{{category}}"}]},
    {"id":5,"type":"timeseries","title":"Octopus Ingest and Dedupe","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"octopus:ingest_processed:rate5m","legendFormat":"processed"},{"refId":"B","expr":"sum(rate(coordinator_ingest_deduplicated_total_count[5m]))","legendFormat":"deduplicated"}]},
    {"id":6,"type":"timeseries","title":"Octopus Backlog","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"octopus:pending_ledger:current","legendFormat":"pending ledger"},{"refId":"B","expr":"max(coordinator_backpressure_active_value)","legendFormat":"backpressure"}]},
    {"id":7,"type":"timeseries","title":"Atheros Search Results and Embedding Cache","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (kind) (rate(athsearch_results_returned_total[5m]))"},{"refId":"B","expr":"rate(athsearch_embedding_cache_hits_total[5m])"},{"refId":"C","expr":"rate(athsearch_embedding_cache_misses_total[5m])"}]}
  ]
}
