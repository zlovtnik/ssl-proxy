{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"Tracing & Jaeger","uid":"tracing-jaeger","time":{"from":"now-6h","to":"now"},
  "templating":{"list":[{"name":"service","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(traces_span_metrics_calls_total, service_name)"},"includeAll":true,"multi":true,"current":{"text":"All","value":"$__all"}}]},
  "panels":[
    {"id":1,"type":"timeseries","title":"Collector Spans Received / Exported","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(otelcol_receiver_accepted_spans[5m]))"},{"refId":"B","expr":"sum(rate(otelcol_exporter_sent_spans[5m]))"}]},
    {"id":2,"type":"timeseries","title":"Failed / Dropped Spans","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(otelcol_exporter_send_failed_spans[5m]))"},{"refId":"B","expr":"sum(rate(otelcol_processor_dropped_spans[5m]))"}]},
    {"id":3,"type":"timeseries","title":"Service Operations","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (service_name, span_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\"}[5m]))","legendFormat":"{{service_name}} {{span_name}}"}]},
    {"id":4,"type":"timeseries","title":"Span Errors and p95 Latency","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",status_code=\"STATUS_CODE_ERROR\"}[5m]))"},{"refId":"B","expr":"histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m]))) / 1000"}]},
    {"id":5,"type":"timeseries","title":"Tail Sampling Decisions","gridPos":{"x":0,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (policy) (rate(otelcol_processor_tail_sampling_count_traces_sampled[5m]))"}]},
    {"id":6,"type":"timeseries","title":"Jaeger Memory and Storage","gridPos":{"x":8,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"container:memory_limit_utilization:ratio{pod=~\"ssl-proxy-telemetry-jaeger.*\"}"},{"refId":"B","expr":"pvc:utilization:ratio{persistentvolumeclaim=\"ssl-proxy-telemetry-jaeger-v2-data\"}"}]},
    {"id":7,"type":"timeseries","title":"Jaeger Restarts and OOM","gridPos":{"x":16,"y":16,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"increase(kube_pod_container_status_restarts_total{pod=~\"ssl-proxy-telemetry-jaeger.*\"}[1h])"},{"refId":"B","expr":"kube_pod_container_status_last_terminated_reason{pod=~\"ssl-proxy-telemetry-jaeger.*\",reason=\"OOMKilled\"}"}]}
  ]
}
