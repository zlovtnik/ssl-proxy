{
  "uid": "infrastructure-capacity",
  "title": "Infrastructure Capacity",
  "schemaVersion": 39,
  "editable": false,
  "time": {"from": "now-6h", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": [
    {"name":"node","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(up{job=\"node-exporter\"}, node)"},"includeAll":true,"multi":true,"current":{"text":"All","value":"$__all"}},
    {"name":"namespace","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(kube_pod_info, namespace)"},"includeAll":true,"current":{"text":"prod-ssl-proxy","value":"prod-ssl-proxy"}},
    {"name":"pod","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)"},"includeAll":true,"multi":true,"current":{"text":"All","value":"$__all"}}
  ]},
  "panels": [
    {"id":8,"type":"row","title":"Telemetry Status","gridPos":{"x":0,"y":0,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":9,"type":"stat","title":"Loki Reachable","gridPos":{"x":0,"y":1,"w":12,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(up{service=\"loki\"} or vector(0))","instant":true}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"background","graphMode":"none"},"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"Unreachable","color":"red"},"1":{"text":"Reachable","color":"green"}}}],"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]}},
    {"id":10,"type":"stat","title":"Grafana Restarts (30m)","gridPos":{"x":12,"y":1,"w":12,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(increase(kube_pod_container_status_restarts_total{container=\"grafana\"}[30m])) or vector(0)","instant":true}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"background","graphMode":"none"},"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]}},
    {"id":1,"type":"row","title":"Cluster Capacity","gridPos":{"x":0,"y":5,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":2,"type":"stat","title":"Cluster CPU","gridPos":{"x":0,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"1 - sum(rate(node_cpu_seconds_total{mode=\"idle\",node=~\"$node\"}[5m])) / sum(rate(node_cpu_seconds_total{node=~\"$node\"}[5m]))"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]}},
    {"id":3,"type":"stat","title":"Cluster Memory","gridPos":{"x":4,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"1 - sum(node_memory_MemAvailable_bytes{node=~\"$node\"}) / sum(node_memory_MemTotal_bytes{node=~\"$node\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]}},
    {"id":4,"type":"stat","title":"Worst PVC","gridPos":{"x":8,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(pvc:utilization:ratio{namespace=~\"$namespace\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]}},
    {"id":5,"type":"stat","title":"Minimum Days To Full","gridPos":{"x":12,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"min((kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"} / -deriv(kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"}[6h])) / 86400 and deriv(kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"}[6h]) < 0)"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"d","noValue":"N/A","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":7},{"color":"green","value":30}]}},"overrides":[]}},
    {"id":6,"type":"stat","title":"Pods Without Memory Limits","gridPos":{"x":16,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"count(kube_pod_info{namespace=~\"$namespace\"} unless on(pod, namespace) kube_pod_container_resource_limits{resource=\"memory\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"noValue":"0","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]}},
    {"id":7,"type":"stat","title":"Current OOMKilled Containers","gridPos":{"x":20,"y":6,"w":4,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kube_pod_container_status_last_terminated_reason{namespace=~\"$namespace\",reason=\"OOMKilled\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"noValue":"0","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]}},
    {"id":11,"type":"row","title":"Nodes","gridPos":{"x":0,"y":11,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":12,"type":"timeseries","title":"Filesystem Utilization","gridPos":{"x":0,"y":12,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"node:filesystem_utilization:ratio{node=~\"$node\"}","legendFormat":"{{node}} {{mountpoint}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":13,"type":"timeseries","title":"Memory Utilization","gridPos":{"x":8,"y":12,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"1 - node_memory_MemAvailable_bytes{node=~\"$node\"} / node_memory_MemTotal_bytes{node=~\"$node\"}","legendFormat":"{{node}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":14,"type":"timeseries","title":"Network RX / TX","gridPos":{"x":16,"y":12,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (node) (rate(node_network_receive_bytes_total{node=~\"$node\",device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*|br-.*\"}[5m]))","legendFormat":"{{node}} RX"},{"refId":"B","expr":"-sum by (node) (rate(node_network_transmit_bytes_total{node=~\"$node\",device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*|br-.*\"}[5m]))","legendFormat":"{{node}} TX"}],"fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":15,"type":"row","title":"Storage","gridPos":{"x":0,"y":20,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":16,"type":"bargauge","title":"PVC Utilization","gridPos":{"x":0,"y":21,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sort_desc(pvc:utilization:ratio{namespace=~\"$namespace\"})","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]},"options":{"displayMode":"gradient","orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":17,"type":"timeseries","title":"PVC Days To Full","gridPos":{"x":12,"y":21,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"(kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"} / -deriv(kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"}[6h])) / 86400 and deriv(kubelet_volume_stats_available_bytes{namespace=~\"$namespace\"}[6h]) < 0","legendFormat":"{{persistentvolumeclaim}}"}],"fieldConfig":{"defaults":{"unit":"d","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":7},{"color":"green","value":30}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":18,"type":"row","title":"Workloads","gridPos":{"x":0,"y":28,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":19,"type":"timeseries","title":"CPU vs Limit","gridPos":{"x":0,"y":29,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m])) / on(pod) sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"cpu\"})","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":20,"type":"timeseries","title":"Memory vs Limit","gridPos":{"x":6,"y":29,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}) / on(pod) sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"})","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":21,"type":"timeseries","title":"CPU Throttling","gridPos":{"x":12,"y":29,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\"}[5m])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\"}[5m])), 0.001)","legendFormat":"{{pod}}"}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.1},{"color":"red","value":0.25}]}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":22,"type":"timeseries","title":"Container Restarts","gridPos":{"x":18,"y":29,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"}[1h])","legendFormat":"{{pod}} {{container}}"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"}}},
    {"id":23,"type":"stat","title":"CPU Requests / Allocatable","gridPos":{"x":0,"y":37,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]}},
    {"id":24,"type":"stat","title":"Memory Requests / Allocatable","gridPos":{"x":6,"y":37,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(kube_pod_container_resource_requests{resource=\"memory\"}) / sum(kube_node_status_allocatable{resource=\"memory\"})"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"colorMode":"value","graphMode":"none"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.7},{"color":"red","value":0.85}]}},"overrides":[]}},
    {"id":25,"type":"table","title":"Pods Without Memory Limits","gridPos":{"x":12,"y":37,"w":12,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_pod_info{namespace=~\"$namespace\",pod=~\"$pod\"} unless on(pod, namespace) kube_pod_container_resource_limits{resource=\"memory\"}","format":"table","instant":true}],"transformations":[{"id":"organize","options":{"excludeByName":{"Time":true,"Value":true}}}]},
    {"id":26,"type":"table","title":"CPU Requests, Limits and Usage","gridPos":{"x":0,"y":42,"w":12,"h":10},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max by (pod) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$pod\"})","format":"table","instant":true},{"refId":"B","expr":"sum by (pod) (kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"cpu\"})","format":"table","instant":true},{"refId":"C","expr":"sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"cpu\"})","format":"table","instant":true},{"refId":"D","expr":"sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m]))","format":"table","instant":true}],"transformations":[{"id":"joinByField","options":{"byField":"pod","mode":"outer"}},{"id":"organize","options":{"excludeByName":{"Time":true,"Value #A":true},"renameByName":{"Value #B":"Request","Value #C":"Limit","Value #D":"Usage"}}},{"id":"calculateField","options":{"mode":"binary","leftFieldName":"Usage","operator":"/","rightFieldName":"Limit","alias":"% of limit","replaceFields":false}}],"fieldConfig":{"defaults":{"unit":"cores"},"overrides":[{"matcher":{"id":"byName","options":"% of limit"},"properties":[{"id":"unit","value":"percentunit"}]}]}},
    {"id":27,"type":"table","title":"Memory Requests, Limits and Usage","gridPos":{"x":12,"y":42,"w":12,"h":10},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max by (pod) (kube_pod_info{namespace=~\"$namespace\",pod=~\"$pod\"})","format":"table","instant":true},{"refId":"B","expr":"sum by (pod) (kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"})","format":"table","instant":true},{"refId":"C","expr":"sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"})","format":"table","instant":true},{"refId":"D","expr":"sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"})","format":"table","instant":true}],"transformations":[{"id":"joinByField","options":{"byField":"pod","mode":"outer"}},{"id":"organize","options":{"excludeByName":{"Time":true,"Value #A":true},"renameByName":{"Value #B":"Request","Value #C":"Limit","Value #D":"Usage"}}},{"id":"calculateField","options":{"mode":"binary","leftFieldName":"Usage","operator":"/","rightFieldName":"Limit","alias":"% of limit","replaceFields":false}}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[{"matcher":{"id":"byName","options":"% of limit"},"properties":[{"id":"unit","value":"percentunit"}]}]}}
  ]
