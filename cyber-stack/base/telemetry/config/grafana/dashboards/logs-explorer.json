{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"Logs Explorer","uid":"logs-explorer","time":{"from":"now-1h","to":"now"},
  "templating":{"list":[
    {"name":"namespace","type":"query","datasource":{"type":"loki","uid":"loki"},"query":"label_values(namespace)","includeAll":true,"allValue":".+","multi":true,"current":{"text":"All","value":".+"}},
    {"name":"service_name","type":"query","datasource":{"type":"loki","uid":"loki"},"query":"label_values({namespace=~\"$namespace\"}, container)","includeAll":true,"allValue":".+","multi":true,"current":{"text":"All","value":".+"}},
    {"name":"level","type":"custom","query":"debug,info,warn,error,fatal","includeAll":true,"allValue":".+","multi":true,"current":{"text":"All","value":".+"}},
    {"name":"trace_id","type":"textbox","label":"Trace ID","current":{"text":".+","value":".+"}}
  ]},
  "panels":[
    {"id":1,"type":"logs","title":"Correlated Service Logs","gridPos":{"x":0,"y":0,"w":24,"h":18},"datasource":{"type":"loki","uid":"loki"},"targets":[{"refId":"A","expr":"{namespace=~\"$namespace\",container=~\"$service_name\"} |~ `(?i)(level|severity)[=: \\\"']*$level` |~ `(?i)trace[_-]?id[=: \\\"']*$trace_id`"}],"options":{"showTime":true,"showLabels":true,"wrapLogMessage":true,"enableLogDetails":true,"sortOrder":"Descending"}},
    {"id":2,"type":"timeseries","title":"Log Volume by Container","gridPos":{"x":0,"y":18,"w":12,"h":8},"datasource":{"type":"loki","uid":"loki"},"targets":[{"refId":"A","expr":"topk(10, sum by (container) (count_over_time({namespace=~\"$namespace\",container=~\"$service_name\"}[$__auto])))","legendFormat":"{{container}}"}]},
    {"id":3,"type":"logs","title":"Logs with Trace IDs (click trace_id)","gridPos":{"x":12,"y":18,"w":12,"h":8},"datasource":{"type":"loki","uid":"loki"},"targets":[{"refId":"A","expr":"{namespace=~\"$namespace\",container=~\"$service_name\",container!~\"alloy|otel-collector\"} |~ `(?i)trace[_-]?id`"}]},
    {"id":4,"type":"logs","title":"Redpanda Daily Clean Plan","description":"Pinned query for the fail-closed partition plan table.","gridPos":{"x":0,"y":26,"w":24,"h":14},"datasource":{"type":"loki","uid":"loki"},"targets":[{"refId":"A","expr":"{container=\"clean\", namespace=\"prod-ssl-proxy\"}"}],"options":{"showTime":true,"showLabels":true,"wrapLogMessage":false,"enableLogDetails":true,"sortOrder":"Descending"}}
  ]
}
