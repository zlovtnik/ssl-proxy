{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"Fleet Availability & GitOps","uid":"fleet-availability","time":{"from":"now-24h","to":"now"},
  "templating":{"list":[]},
  "panels":[
    {"id":1,"type":"stat","title":"Healthy Scrape Targets","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(up)"}]},
    {"id":2,"type":"stat","title":"Failed Availability Probes","gridPos":{"x":6,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(probe_success == 0)"}]},
    {"id":3,"type":"timeseries","title":"Rolling Availability","gridPos":{"x":12,"y":0,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"service:probe_availability:ratio_rate1h","legendFormat":"{{service}} 1h"},{"refId":"B","expr":"service:probe_availability:ratio_rate24h","legendFormat":"{{service}} 24h"},{"refId":"C","expr":"service:probe_availability:ratio_rate7d","legendFormat":"{{service}} 7d"}]},
    {"id":4,"type":"timeseries","title":"Desired versus Ready Replicas","gridPos":{"x":0,"y":5,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_deployment_spec_replicas","legendFormat":"{{deployment}} desired"},{"refId":"B","expr":"kube_deployment_status_replicas_available","legendFormat":"{{deployment}} ready"}]},
    {"id":5,"type":"table","title":"Argo CD Application Sync and Health","gridPos":{"x":0,"y":14,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"argocd_app_info","format":"table","instant":true}]},
    {"id":6,"type":"timeseries","title":"Restarts and OOMs","gridPos":{"x":12,"y":9,"w":12,"h":14},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"increase(kube_pod_container_status_restarts_total[1h])","legendFormat":"{{pod}} restarts"},{"refId":"B","expr":"kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}","legendFormat":"{{pod}} OOM"}]}
  ]
}
