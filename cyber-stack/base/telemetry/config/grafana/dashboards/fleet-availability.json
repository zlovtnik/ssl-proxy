{
  "annotations":{"list":[]},"editable":false,"schemaVersion":39,"title":"Fleet Availability & GitOps","uid":"fleet-availability","time":{"from":"now-24h","to":"now"},
  "templating":{"list":[{"name":"environment","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(up, environment)"},"current":{"text":"All","value":"$__all"},"includeAll":true,"multi":true}]},
  "panels":[
    {"id":1,"type":"stat","title":"Healthy Scrape Targets","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(up{environment=~\"$environment\"})"}]},
    {"id":2,"type":"stat","title":"Failed Availability Probes","gridPos":{"x":6,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(probe_success{environment=~\"$environment\"} == 0)"}]},
    {"id":3,"type":"timeseries","title":"Rolling Availability","gridPos":{"x":12,"y":0,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"service:probe_availability:ratio_rate1h{environment=~\"$environment\"}","legendFormat":"{{service}} 1h"},{"refId":"B","expr":"service:probe_availability:ratio_rate24h{environment=~\"$environment\"}","legendFormat":"{{service}} 24h"},{"refId":"C","expr":"service:probe_availability:ratio_rate7d{environment=~\"$environment\"}","legendFormat":"{{service}} 7d"}]},
    {"id":4,"type":"timeseries","title":"Desired versus Ready Replicas","gridPos":{"x":0,"y":5,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_deployment_spec_replicas{environment=~\"$environment\"}","legendFormat":"{{deployment}} desired"},{"refId":"B","expr":"kube_deployment_status_replicas_available{environment=~\"$environment\"}","legendFormat":"{{deployment}} ready"}]},
    {"id":5,"type":"table","title":"Argo CD Application Sync and Health","gridPos":{"x":0,"y":14,"w":12,"h":9},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"argocd_app_info{environment=~\"$environment\"}","format":"table","instant":true}]},
    {"id":6,"type":"timeseries","title":"Restarts and OOMs","gridPos":{"x":12,"y":9,"w":12,"h":14},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"increase(kube_pod_container_status_restarts_total{environment=~\"$environment\"}[1h])","legendFormat":"{{pod}} restarts"},{"refId":"B","expr":"kube_pod_container_status_last_terminated_reason{environment=~\"$environment\",reason=\"OOMKilled\"}","legendFormat":"{{pod}} OOM"}]}
  ]
}
